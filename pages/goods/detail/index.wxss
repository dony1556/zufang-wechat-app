.detail-content::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
.sticky-box .tab-box {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 99;
}
.goodes_detail_swiper-box {
  width: 750rpx;
  height: 750rpx;
  position: relative;
}
.goodes_detail_swiper-box .carousel {
  width: 750rpx;
  height: 100%;
}
.goodes_detail_swiper-box .carousel-item {
  width: 750rpx;
  height: 100%;
}
.goodes_detail_swiper-box .swiper-image {
  width: 750rpx;
  height: 100%;
  background: #ccc;
}
.goodes_detail_swiper-box .swiper-dots {
  display: flex;
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  line-height: 44rpx;
  border-radius: 22rpx;
  padding: 0 15rpx;
  background: rgba(51, 51, 51, 0.3);
  font-size: 28rpx;
  color: hsla(0, 0%, 100%, 0.9);
}
.sku-box {
  line-height: 82rpx;
  background: #fff;
  padding: 0 20rpx;
  margin: 20rpx 0;
  font-size: 28rpx;
}
.sku-box .title {
  color: #999;
  margin-right: 20rpx;
}
.sku-box .cuIcon-right {
  color: #bfbfbf;
  font-size: 36rpx;
}
.goods-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 42rpx;
  background-color: #fff;
  padding-bottom: 10rpx;
  padding: 10rpx 20rpx;
}
.sub-title {
  padding: 0 20rpx;
  color: #a8700d;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 42rpx;
  background-color: #fff;
  padding-bottom: 10rpx;
}
.tab-box {
  height: 102rpx;
  background: #fff;
  border-bottom: 1rpx solid hsla(0, 0%, 87.5%, 0.8);
  margin-top: 20rpx;
}
.tab-box .tab-item {
  flex: 1;
  height: 100%;
  position: relative;
  font-size: 30rpx;
  font-weight: 700;
}
.tab-box .tab-item .tab-line {
  width: 123rpx;
  height: 4rpx;
  left: 50%;
  bottom: 20rpx;
  transform: translateX(-50%);
  background: transparent;
  position: absolute;
  z-index: 2;
}
.tab-box .tab-item .line-active {
  background: #a8700d;
}
.tab-detail {
  min-height: 300rpx;
  background: #fff;
  padding-bottom: 30rpx;
  background: #fff;
}
.tab-detail .rich-box image {
  margin-top: -1rpx;
}
.tab-detail .goods-size {
  padding-top: 30rpx;
}
.tab-detail .goods-size .table-box {
  width: 710rpx;
  margin: auto;
  background: #fff;
  border: 1rpx solid #dfdfdf;
}
.tab-detail .goods-size .table-box .t-tr {
  border-bottom: 1rpx solid #dfdfdf;
}
.tab-detail .goods-size .table-box .t-tr:last-child {
  border-bottom: none;
}
.tab-detail .goods-size .table-box .t-tr .t-head {
  font-size: 26rpx;
  color: #999;
  flex: 1;
  padding: 15rpx 20rpx;
  height: 100%;
  border-right: 1rpx solid #dfdfdf;
}
.tab-detail .goods-size .table-box .t-tr .t-detail {
  font-size: 26rpx;
  flex: 4;
  padding: 15rpx 20rpx;
  height: 100%;
}
.tab-detail .goods-comment {
  padding-top: 30rpx;
}
.tab-detail .goods-comment .more-box {
  height: 100rpx;
  background: #fff;
}
.tab-detail .goods-comment .more-box .more-btn {
  width: 200rpx;
  height: 60rpx;
  border: 1rpx solid #d5a65a;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: #a8700d;
  padding: 0;
  background: #fff;
}
.tab-detail .goods-comment .more-box .more-btn .cuIcon-right {
  font-size: 30rpx;
  margin-left: 10rpx;
}
.guess-box .guess-title {
  height: 90rpx;
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: 700;
  color: #333;
  background: #fff;
  padding: 0 20rpx;
}
.guess-box .goods-wrap {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
}
.guess-box .goods-wrap .goods-item {
  margin-right: 20rpx;
  margin-bottom: 20rpx;
}
.guess-box .goods-wrap .goods-item:nth-child(2n) {
  margin-right: 0;
}
.score-foot-box {
  height: 110rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  width: 100%;
  position: fixed;
  bottom: 0;
  z-index: 999;
}
.score-foot-box .left,
.score-foot-box .right {
  flex: 1;
}
.score-foot-box .tools-item {
  flex: 1;
  height: 100%;
  position: relative;
}
.score-foot-box .tools-item .badge {
  position: absolute;
  top: 0rpx;
  right: 6rpx;
  font-size: 22rpx;
  line-height: 24rpx;
  padding: 6rpx;
  background-color: #f74d54;
  color: #fff;
}
.score-foot-box .tools-item .tool-img {
  width: 46rpx;
  height: 46rpx;
}
.score-foot-box .tools-item .tool-title {
  font-size: 22rpx;
  line-height: 22rpx;
  padding-top: 8rpx;
}
.score-foot-box .btn-box {
  flex: 1;
}
.score-foot-box .btn-box .seckill-btn {
  width: 600rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #3185f3, #50cdf2);
  box-shadow: 0 7px 6px 0 rgba(80, 205, 242, 0.2);
  border-radius: 40rpx;
  font-size: 30rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #fff;
  margin-right: 20rpx;
}
.detail-foot_box {
  height: 100rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  width: 100%;
  position: fixed;
  bottom: 0;
  z-index: 999;
}
.detail-foot_box .left,
.detail-foot_box .detail-right {
  flex: 1;
}
.detail-foot_box .tools-item {
  flex: 1;
  height: 100%;
  position: relative;
}
.detail-foot_box .tools-item .badge {
  position: absolute;
  top: 0rpx;
  right: 6rpx;
  font-size: 24rpx;
  padding: 4rpx 8rpx;
  background-color: #f74d54;
  color: #fff;
  border-radius: 50%;
  min-width: 36rpx;
  text-align: center;
}
.detail-foot_box .tools-item .tool-img {
  width: 46rpx;
  height: 46rpx;
}
.detail-foot_box .tools-item .tool-title {
  font-size: 22rpx;
  line-height: 22rpx;
  padding-top: 8rpx;
}
.detail-foot_box .detail-btn-box {
  flex: 1;
}
.detail-foot_box .detail-btn-box .tool-btn {
  font-size: 28rpx;
  font-weight: 500;
  color: hsla(0, 0%, 100%, 0.9);
  width: 210rpx;
  height: 70rpx;
  border-radius: 35rpx;
  padding: 0;
  margin-right: 20rpx;
}
.detail-foot_box .detail-btn-box .tool-btn .price {
  font-size: 24rpx;
  font-weight: 700;
  color: hsla(0, 0%, 100%, 0.9);
}
.detail-foot_box .detail-btn-box .tool-btn .price-title {
  font-size: 20rpx;
  font-weight: 500;
  color: hsla(0, 0%, 100%, 0.9);
  padding-top: 8rpx;
}
.detail-foot_box .detail-btn-box .add-btn {
  box-shadow: 0 2rpx 5rpx 0 rgba(102, 103, 104, 0.46);
  background: #eb0909;
  color: #fff;
}
.detail-foot_box .detail-btn-box .pay-btn {
  box-shadow: 0 7rpx 6rpx 0 rgba(229, 138, 0, 0.22);
  background: #fc872d;
  color: #fff;
}
.detail-foot_box .detail-btn-box .seckill-btn {
  width: 432rpx;
  height: 70rpx;
  background: linear-gradient(93deg, #d01325, #ed3c30);
  box-shadow: 0 7rpx 6rpx 0 rgba(237, 60, 48, 0.22);
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #fff;
  border-radius: 35rpx;
  padding: 0;
  margin-right: 20rpx;
}
.detail-foot_box .detail-btn-box .seckilled-btn {
  width: 432rpx;
  height: 70rpx;
  background: #ddd;
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999;
  border-radius: 35rpx;
  padding: 0;
  margin-right: 20rpx;
}
.detail-foot_box .detail-btn-box .groupon-btn {
  width: 210rpx;
  height: 70rpx;
  background: linear-gradient(90deg, #fe832a, #f60);
  box-shadow: 0 7rpx 6rpx 0 rgba(255, 104, 4, 0.22);
  border-radius: 35rpx;
}
