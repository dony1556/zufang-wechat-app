.page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page .top-box {
  display: flex;
}
.page .content-box {
  flex: 1;
  overflow-y: auto;
}
.page .content-box .swiper-box .swiper {
  height: 500rpx;
}
.page .content-box .swiper-box .swiper .img {
  width: 100%;
  height: 100%;
}
.page .content-box .goods-info {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 15rpx 3%;
  background-color: #fff;
  margin-bottom: 8rpx;
}
.page .content-box .goods-info .left {
  flex: 1;
  width: 0;
  display: flex;
  flex-direction: column;
}
.page .content-box .goods-info .left .share {
  width: 80rpx;
  height: 80rpx;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.page .content-box .goods-info .left .share .text {
  font-size: 26rpx;
}
.page .content-box .goods-info .left .price {
  font-size: 28rpx;
  font-weight: 600;
  color: #f47925;
  margin-bottom: 10rpx;
}
.page .content-box .goods-info .left .title {
  font-size: 28rpx;
  letter-spacing: 2rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 40rpx;
}
.page .content-box .info2 {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 20rpx;
  background-color: #fff;
  margin: 2rpx 0rpx;
}
.page .content-box .info2 text {
  font-size: 26rpx;
  color: #afafaf;
}
.page .content-box .description {
  background-color: #fff;
  margin-top: 2rpx;
}
.page .content-box .description .title {
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}
.page .content-box .description .content {
  padding: 10rpx 15rpx;
}
.page .content-box .description .content .img-box {
  margin-top: 8rpx;
  width: 100%;
}
.page .content-box .description .content .img-box .img {
  width: 100%;
  border-radius: 4rpx;
}
.page .footer-box .footer {
  width: 100%;
  height: 110rpx;
  border-top: solid 1rpx #eee;
  background-color: #fff;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 3%;
}
.page .footer-box .footer .icons {
  display: flex;
}
.page .footer-box .footer .icons .home {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.page .footer-box .footer .icons .home image {
  width: 50rpx;
  height: 50rpx;
}
.page .footer-box .footer .icons .home .text {
  display: flex;
  justify-content: center;
  width: 100%;
  font-size: 22rpx;
  color: #666;
}
.page .footer-box .footer .icons .kefu {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  margin-right: 20rpx;
  position: relative;
}
.page .footer-box .footer .icons .kefu .text {
  display: flex;
  justify-content: center;
  width: 100%;
  font-size: 22rpx;
  color: #666;
}
.page .footer-box .footer .btn {
  border-radius: 40rpx;
  overflow: hidden;
  display: flex;
}
.page .footer-box .footer .btn .buy {
  height: 76rpx;
  width: 300rpx;
  line-height: 76rpx;
  color: #fff;
  background-color: #ff0036;
  font-size: 26rpx;
  text-align: center;
}
