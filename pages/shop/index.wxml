<view class="page">
    <view class="float">
        <view catchtap="__e" class="btn" data-event-opts="{{[ [ 'tap',[ [ 'navToOrder',['$event'] ] ] ] ]}}">订单</view>
    </view>
    <view class="swiper-box">
        <swiper autoplay="true" class="slide-swiper">
            <swiper-item class="swiper-item" wx:for="{{swiperList}}" wx:key="index">
                <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'navto',['$event'] ] ] ] ]}}">
                    <image class="img" mode="aspectFill" src="{{item.img}}"></image>
                </view>
            </swiper-item>
        </swiper>
    </view>
    <view class="scroll-box">
        <scroll-view class="scroll" scrollX="{{true}}">
            <view bindtap="__e" class="{{['item',type_id==0?'on':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'tabChange',[0] ] ] ] ]}}">全部</view>
            <view bindtap="__e" class="{{['item',type_id==item.id?'on':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'tabChange',['$0'],[ [ ['type_list','',index,'id'] ] ] ] ] ] ]}}" wx:for="{{type_list}}" wx:key="index">{{item.name}}</view>
        </scroll-view>
    </view>
    <view class="goods-box">
        <view class="goods-list">
            <view bindtap="__e" class="goods" data-event-opts="{{[ [ 'tap',[ [ 'toDetail',['$0'],[ [ ['goodsList','',index,'id'] ] ] ] ] ] ]}}" wx:for="{{goodsList}}" wx:key="index">
                <image class="img" mode="aspectFill" src="{{item.cover}}"></image>
                <view class="title">{{item.title}}</view>
                <view class="info">
                    <view class="price">{{item.credit+'积分+'+item.money+'元'}}</view>
                    <view class="slogan">{{item.slogan}}</view>
                </view>
            </view>
        </view>
    </view>
    <wk-skeletons bind:__l="__l" type="detail" vueId="a932cbd8-1" wx:if="{{isLoading}}"></wk-skeletons>
</view>
