.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #fff;
}
.page .top-box .scroll-box {
  background-color: #fff;
  width: 100%;
  border-bottom: 1rpx solid #f7f8f9;
  position: -webkit-sticky;
  position: sticky;
}
.page .top-box .scroll-box .scroll {
  height: 90rpx;
  white-space: nowrap;
  width: 100%;
  text-align: center;
}
.page .top-box .scroll-box .scroll .item {
  height: 90rpx;
  padding: 0 30rpx;
  display: inline-block;
}
.page .top-box .scroll-box .scroll .item .name {
  height: 76rpx;
  line-height: 76rpx;
}
.page .top-box .scroll-box .scroll .item .line {
  margin-left: 20%;
  width: 60%;
  height: 4rpx;
  background-color: #5a0;
  border-radius: 6rpx;
}
.page .content-box {
  flex: 1;
  overflow-y: auto;
  background-color: #f9f9f9;
}
.page .content-box .yy-box {
  width: 100%;
  padding: 0rpx 20rpx;
}
.page .content-box .yy-box .item {
  border-radius: 8rpx;
  background-color: #fff;
  padding: 20rpx;
  margin-top: 20rpx;
}
.page .content-box .yy-box .item .head {
  display: flex;
  align-items: center;
  height: 60rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.page .content-box .yy-box .item .head .title {
  font-weight: 700;
  flex: 1;
  width: 0;
}
.page .content-box .yy-box .item .content {
  padding: 20rpx 16rpx;
}
.page .content-box .yy-box .item .content .name {
  font-size: 26rpx;
}
.page .content-box .yy-box .item .content .tel {
  font-size: 26rpx;
  margin-top: 20rpx;
}
.page .content-box .yy-box .item .content .time {
  font-size: 26rpx;
  margin-top: 20rpx;
}
.page .content-box .yy-box .item .btn-box {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 30rpx;
}
.page .content-box .yy-box .item .btn-box .sign-btn {
  height: 52rpx;
  width: 160rpx;
  border: 1rpx solid #afafaf;
  line-height: 52rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-right: 30rpx;
  font-size: 24rpx;
}
.page .content-box .yy-box .item .btn-box .see-btn {
  height: 52rpx;
  width: 120rpx;
  border: 1rpx solid #afafaf;
  line-height: 52rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
  margin-right: 30rpx;
}
.page .content-box .yy-box .item .btn-box .cancel-btn {
  height: 52rpx;
  width: 120rpx;
  border: 1rpx solid #afafaf;
  line-height: 52rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 24rpx;
}
