.page .content-box .wallet-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}
.page .content-box .wallet-box .img {
  width: 120rpx;
  height: 120rpx;
  margin-top: 50rpx;
  margin-bottom: 50rpx;
}
.page .content-box .wallet-box .money {
  font-size: 30rpx;
  font-weight: 700;
  color: red;
}
.page .content-box .scroll-box {
  background: #fff;
}
.page .content-box .scroll-box .scroll {
  white-space: nowrap;
  height: 90rpx;
  text-align: center;
}
.page .content-box .scroll-box .scroll .item {
  position: relative;
  display: inline-block;
  width: 50%;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
}
.page .content-box .scroll-box .scroll .item.on {
  font-weight: 700;
  color: #f50;
}
.page .content-box .bottom {
  margin-top: 12rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  flex-direction: column;
}
.page .content-box .bottom .pay-box {
  display: flex;
  margin: 0 60rpx;
  align-items: center;
  width: 630rpx;
  border-bottom: 1rpx solid #eee;
}
.page .content-box .bottom .pay-box .left {
  flex: 1;
  width: 0;
  height: 110rpx;
}
.page .content-box .bottom .pay-btn {
  height: 80rpx;
  width: 630rpx;
  margin: 40rpx auto;
  background-color: #63b931;
  text-align: center;
  color: #fff;
  border-radius: 12rpx;
  line-height: 80rpx;
}
.page .content-box .bottom .cz-log {
  color: #8799a3;
  font-size: 24rpx;
  padding-bottom: 40rpx;
}
.page .content-box .bottom .tx-box {
  display: flex;
  margin: 0 60rpx;
  align-items: center;
  width: 630rpx;
  border-bottom: 1rpx solid #eee;
}
.page .content-box .bottom .tx-box .title {
  width: 200rpx;
  font-size: 26rpx;
}
.page .content-box .bottom .tx-box .input {
  height: 90rpx;
  flex: 1;
  width: 0;
  font-size: 26rpx;
}
.page .content-box .bottom .tip {
  width: 690rpx;
  padding: 20rpx;
  margin: 10rpx 60rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}
.page .content-box .bottom .tx-log {
  color: #8799a3;
  font-size: 24rpx;
  padding-bottom: 40rpx;
}
.page .content-box .bottom .tx-btn {
  height: 80rpx;
  width: 630rpx;
  margin: 30rpx auto;
  background-color: #50c1e9;
  text-align: center;
  color: #fff;
  border-radius: 12rpx;
  line-height: 80rpx;
}
