.page {
  background-color: #fff;
}
.page .content-box .item-box .item {
  padding: 26rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.page .content-box .item-box .item .title {
  font-size: 26rpx;
}
.page .content-box .item-box .item .money-box {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 20rpx;
}
.page .content-box .item-box .item .money-box .money {
  font-size: 26rpx;
  color: #f43f3b;
  font-weight: 700;
}
.page .content-box .item-box .item .money-box .time {
  font-size: 26rpx;
  color: #cacaca;
}
