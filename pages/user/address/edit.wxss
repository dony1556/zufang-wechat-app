.address-item {
  height: 96rpx;
  background: #fff;
  border-bottom: 1rpx solid hsla(0, 0%, 87.5%, 0.5);
  padding: 0 25rpx;
}
.address-item .item-title {
  color: #333;
  font-size: 28rpx;
  white-space: nowrap;
}
.address-item .inp {
  color: #333;
  font-size: 28rpx;
}
.area-box {
  min-height: 120rpx;
  padding-bottom: 60rpx;
  background: #fff;
  padding: 30rpx 25rpx;
}
.area-box .item-title {
  font-size: 28rpx;
  white-space: nowrap;
}
.area-box .area-inp {
  color: #999;
  font-size: 28rpx;
  padding-right: 30rpx;
}
.default-box {
  height: 100rpx;
  padding: 0 25rpx;
  background: #fff;
  margin-top: 20rpx;
}
.default-box .title {
  font-size: 28rpx;
}
.default-box .switch {
  transform: scale(0.8);
}
.foot_box {
  padding: 20rpx;
}
.foot_box .add-btn {
  width: 710rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #e9b461, #eecc89);
  border: 1rpx solid #eee;
  border-radius: 40rpx;
  color: hsla(0, 0%, 100%, 0.9);
}
.foot_box .delete-btn {
  width: 432rpx;
  height: 70rpx;
  background: linear-gradient(93deg, #d01325, #ed3c30);
  box-shadow: 0 7rpx 6rpx 0 rgba(237, 60, 48, 0.22);
  font-size: 28rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #fff;
  border-radius: 35rpx;
  padding: 0;
  margin-right: 20rpx;
}
.foot_box .save-btn {
  width: 432rpx;
  height: 70rpx;
  background: linear-gradient(90deg, #e9b461, #eecc89);
  border: 1rpx solid #eee;
  border-radius: 40rpx;
  color: hsla(0, 0%, 100%, 0.9);
}
