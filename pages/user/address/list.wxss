.address-list {
  padding: 40rpx;
  position: relative;
  background: #fff;
  margin-bottom: 20rpx;
}
.address-list .name,
.address-list .phone {
  font-size: 30rpx;
  font-weight: 600;
}
.address-list .phone {
  margin: 0 20rpx;
}
.address-list .tag {
  background: rgba(233, 191, 113, 0.2);
  border-radius: 6rpx;
  padding: 0 16rpx;
  line-height: 38rpx;
  color: #a8700d;
  font-size: 22rpx;
}
.address-list .detail {
  margin-top: 25rpx;
  width: 543rpx;
  font-size: 26rpx;
  font-family: PingFang SC;
  font-weight: 400;
  color: #999;
  line-height: 40rpx;
}
.address-list .set-btn {
  background: none;
  position: absolute;
  font-size: 26rpx;
  color: #a8700d;
  top: 40rpx;
  right: 20rpx;
}
.foot_box {
  padding: 20rpx;
}
.foot_box .add-btn {
  width: 710rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #e9b461, #eecc89);
  border: 1rpx solid #eee;
  border-radius: 40rpx;
  color: hsla(0, 0%, 100%, 0.9);
}
