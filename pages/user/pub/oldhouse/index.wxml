<view class="page">
    <view class="top-box"></view>
    <view class="body-box">
        <view bindsubmit="__e" class="form" data-event-opts="{{[ [ 'submit',[ [ 'formSubmit',['$event'] ] ] ] ]}}">
            <view style="border-radius:12rpx;overflow:hidden;background-color:#FFFFFF;">
                <view bindtap="__e" class="form-item" data-event-opts="{{[ [ 'tap',[ [ 'openCommunity',['$event'] ] ] ] ]}}">
                    <text class="title">小区</text>
                    <view class="right">
                        <view class="choose-box">
                            <view class="text">{{pubCommunity.name||'请选择小区'}}</view>
                            <view class="iconfont icon-you icon "></view>
                        </view>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">栋</text>
                    <view class="right">
                        <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','dong','$event',[] ],['house'] ] ] ] ]}}" placeholder="不对外展示" value="{{house.dong}}"></input>
                        <view class="unit">栋</view>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">单元</text>
                    <view class="right">
                        <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','dy','$event',[] ],['house'] ] ] ] ]}}" placeholder="不对外展示" value="{{house.dy}}"></input>
                        <view class="unit">单元</view>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">门牌号</text>
                    <view class="right">
                        <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','doorplate','$event',[] ],['house'] ] ] ] ]}}" placeholder="不对外展示" value="{{house.doorplate}}"></input>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">售价</text>
                    <view class="right">
                        <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','money','$event',[] ],['house'] ] ] ] ]}}" placeholder="请输入售价" type="number" value="{{house.money}}"></input>
                        <view class="unit">万元</view>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">联系人</text>
                    <view class="right">
                        <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','name','$event',[] ],['house'] ] ] ] ]}}" placeholder="请输入联系人" value="{{house.name}}"></input>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">联系电话</text>
                    <view class="right">
                        <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','tel','$event',[] ],['house'] ] ] ] ]}}" placeholder="请输入联系电话" type="number" value="{{house.tel}}"></input>
                    </view>
                </view>
            </view>
            <view style="border-radius:12rpx;overflow:hidden;background-color:#FFFFFF;margin-top:16rpx;">
                <view class="form-item">
                    <view class="title">房屋面积</view>
                    <view class="right">
                        <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','mj','$event',[] ],['house'] ] ] ] ]}}" placeholder="请填写房屋面积" type="number" value="{{house.mj}}"></input>
                        <view class="unit">㎡</view>
                    </view>
                </view>
                <view class="form-item" wx:for="{{form_data}}" wx:key="index">
                    <text class="title">{{item.name}}</text>
                    <view class="right">
                        <input placeholder bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','value','$event',[] ],[ [ ['form_data','',index] ] ] ] ] ] ]}}" value="{{item.value}}"></input>
                    </view>
                </view>
                <view bindtap="__e" class="form-item" data-event-opts="{{[ [ 'tap',[ [ 'openHouseStw',['$event'] ] ] ] ]}}">
                    <text class="title">户型</text>
                    <view class="right">
                        <view class="choose-box">
                            <view class="text">{{house.stw_names||'请选择户型'}}</view>
                            <view class="iconfont icon-you icon "></view>
                        </view>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">类型</text>
                    <view class="right">
                        <picker bindchange="__e" class="picker" data-event-opts="{{[ [ 'change',[ [ 'typeChange',['$event'] ] ] ] ]}}" mode="selector" range="{{typeList}}" rangeKey="name" value="{{typeIndex}}">
                            <view class="picker-box">
                                <view class="text">{{typeList[house.typeIndex].name}}</view>
                                <view class="iconfont icon-you  icon"></view>
                            </view>
                        </picker>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">装修</text>
                    <view class="right">
                        <picker bindchange="__e" class="picker" data-event-opts="{{[ [ 'change',[ [ 'decorateChange',['$event'] ] ] ] ]}}" mode="selector" range="{{decorateList}}" rangeKey="name" value="{{decorateIndex}}">
                            <view class="picker-box">
                                <view class="text">{{decorateList[house.decorateIndex].name}}</view>
                                <view class="iconfont icon-you  icon "></view>
                            </view>
                        </picker>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">朝向</text>
                    <view class="right">
                        <picker bindchange="__e" class="picker" data-event-opts="{{[ [ 'change',[ [ 'directionChange',['$event'] ] ] ] ]}}" mode="selector" range="{{directionList}}" rangeKey="name" value="{{directionIndex}}">
                            <view class="picker-box">
                                <view class="text">{{directionList[house.directionIndex].name||'请选择朝向'}}</view>
                                <view class="iconfont icon-you  icon"></view>
                            </view>
                        </picker>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">建房年代</text>
                    <view class="right">
                        <picker bindchange="__e" class="picker" data-event-opts="{{[ [ 'change',[ [ 'yearChange',['$event'] ] ] ] ]}}" fields="year" mode="date" value="{{house.year}}">
                            <view class="picker-box">
                                <view class="text">{{house.year||'请选择建房年代'}}</view>
                                <view class="iconfont icon-you icon"></view>
                            </view>
                        </picker>
                    </view>
                </view>
                <view class="floor-item">
                    <view class="title">楼层</view>
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','floor','$event',[] ],['house'] ] ] ] ]}}" placeholder="请填写" type="number" value="{{house.floor}}"></input>
                    <view class="unit">层</view>
                    <view class="title" style="margin-left:20rpx;">共</view>
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','floor_total','$event',[] ],['house'] ] ] ] ]}}" placeholder="请填写" type="number" value="{{house.floor_total}}"></input>
                    <view class="unit">层</view>
                </view>
                <view class="form-item">
                    <view class="title">电梯</view>
                    <view class="right">
                        <view class="_div" style="display:flex;align-items:center;">
                            <view bindtap="__e" data-event-opts="{{[ [ 'tap',[ [ 'select_elevator',['$0'],[ [ ['elevatorList','',index,'value'] ] ] ] ] ] ]}}" style="display:flex;align-items:center;" wx:for="{{elevatorList}}" wx:key="index">
                                <view class="iconfont icon-gouxuan" style="font-size:35rpx;color:#ff4544;" wx:if="{{house.is_elevator==item.value}}"></view>
                                <view class="iconfont icon-gouxuan1" style="font-size:35rpx;color:#999;" wx:if="{{house.is_elevator!=item.value}}"></view>
                                <view style="margin:0rpx  20rpx;font-size:40rpx;">{{item.name}}</view>
                            </view>
                        </view>
                    </view>
                </view>
                <view bindtap="__e" class="form-item" data-event-opts="{{[ [ 'tap',[ [ 'openTag',['$event'] ] ] ] ]}}">
                    <text class="title">标签</text>
                    <view class="right">
                        <view class="choose-box">
                            <view class="text">{{house.tag_names||'请选择标签'}}</view>
                            <view class="iconfont icon-you icon"></view>
                        </view>
                    </view>
                </view>
            </view>
            <view style="border-radius:12rpx;overflow:hidden;background-color:#FFFFFF;margin-top:16rpx;">
                <view class="form-item">
                    <text class="title">介绍图片</text>
                    <view class="right">
                        <view class="img-box">
                            <view class="preview-box" wx:for="{{house.thumbs}}" wx:key="index">
                                <image class="preview-img" mode="aspectFill" src="{{item}}"></image>
                                <text bindtap="__e" class="cuIcon-close" data-event-opts="{{[ [ 'tap',[ [ 'delImg',['$0',index],['house.thumbs'] ] ] ] ]}}"></text>
                            </view>
                            <view bindtap="__e" class="choose-img  " data-event-opts="{{[ [ 'tap',[ [ 'onChooseImg',['$0',9],['house.thumbs'] ] ] ] ]}}" wx:if="{{$root.g0<9}}">
                                <text class="cuIcon-cameraadd"></text>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="form-item">
                    <text class="title">介绍视频</text>
                    <view class="right">
                        <view class="img-box">
                            <view class="preview-box" wx:if="{{house.video}}">
                                <video class="preview-video" src="{{house.video}}"></video>
                                <text bindtap="__e" class="cuIcon-close" data-event-opts="{{[ [ 'tap',[ ['delVideo'] ] ] ]}}"></text>
                            </view>
                            <view bindtap="__e" class="choose-img  " data-event-opts="{{[ [ 'tap',[ ['onChooseVideo'] ] ] ]}}" wx:if="{{!house.video}}">
                                <text class="cuIcon-cameraadd"></text>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="form-item2">
                    <text class="title-box">房屋详情</text>
                    <view class="bot-box">
                        <textarea bindinput="__e" class="textarea" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','content','$event',[] ],['house'] ] ] ] ]}}" placeholder="请填写房屋详细介绍" value="{{house.content}}"></textarea>
                    </view>
                </view>
                <view class="form-item2" wx:if="{{role=='fd'&&basicSet.fd_set.is_fcz==1}}">
                    <text class="title-box">房产证、土地使用证、业主身份证正反面</text>
                    <view class="bot-box">
                        <view class="img-box">
                            <view class="preview-box" ey="index" wx:for="{{house.fcz_imgs}}">
                                <image class="preview-img" mode="aspectFill" src="{{item}}"></image>
                                <text bindtap="__e" class="cuIcon-close" data-event-opts="{{[ [ 'tap',[ [ 'delImg',['$0',index],['house.fcz_imgs'] ] ] ] ]}}"></text>
                            </view>
                            <view bindtap="__e" class="choose-img " data-event-opts="{{[ [ 'tap',[ [ 'onChooseImg',['$0',9],['house.fcz_imgs'] ] ] ] ]}}" wx:if="{{$root.g1<9}}">
                                <text class="cuIcon-cameraadd"></text>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="form-item2">
                    <text class="title-box">备注(不对外展示)</text>
                    <view class="bot-box">
                        <textarea bindinput="__e" class="textarea" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','own_remarks','$event',[] ],['house'] ] ] ] ]}}" placeholder="请填写备注" value="{{house.own_remarks}}"></textarea>
                    </view>
                </view>
            </view>
            <view class="treaty">
                <view bindtap="__e" class="iconfont icon-gouxuan" data-event-opts="{{[ [ 'tap',[ [ 'handTreaty',['$event'] ] ] ] ]}}" style="font-size:36rpx;color:#ff5500;" wx:if="{{treaty_agree}}"></view>
                <view bindtap="__e" class="iconfont icon-gouxuan1" data-event-opts="{{[ [ 'tap',[ [ 'handTreaty',['$event'] ] ] ] ]}}" style="font-size:36rpx;color:#c3c3c3;" wx:if="{{!treaty_agree}}"></view>
                <view class="txt">我已经阅读并接受<text bindtap="__e" data-event-opts="{{[ [ 'tap',[ [ 'navToTreaty',['$event'] ] ] ] ]}}" style="color:#014c8c;">【发布协议】</text>
                </view>
            </view>
            <view class="btn-box">
                <form bindsubmit="__e" data-event-opts="{{[ [ 'submit',[ [ 'formSubmit',['$event'] ] ] ] ]}}">
                    <button class="submit" formType="submit" type="primary">提交<block wx:if="{{basicSet.fd_set.house_pub_fee>0&&house.id==0}}">{{'(￥'+basicSet.fd_set.house_pub_fee+')'}}</block>
                    </button>
                </form>
            </view>
        </view>
    </view>
    <house-stw bind:__l="__l" bind:onConfirm="__e" class="vue-ref" data-event-opts="{{[ [ '^onConfirm',[ ['stwConfirm'] ] ] ]}}" data-ref="houseStw" vueId="458e3edd-1"></house-stw>
    <wk-multi-select bind:__l="__l" bind:confirm="__e" class="vue-ref" data-event-opts="{{[ [ '^confirm',[ ['tagConfirm'] ] ] ]}}" data-ref="multiSelect" listArr="{{tagList}}" vueId="458e3edd-2"></wk-multi-select>
</view>
