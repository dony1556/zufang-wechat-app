}
.page .body-box .lx-box .content .item {
  display: flex;
  align-items: center;
  height: 100rpx;
  border-bottom: 1rpx solid #f4f4f4;
}
.page .body-box .lx-box .content .item .name {
  margin-right: 30rpx;
  font-size: 26rpx;
}
.page .body-box .lx-box .content .item .input {
  font-size: 26rpx;
}
.page .body-box .b-box {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 30rpx;
  padding: 0rpx 30rpx;
}
.page .body-box .b-box .submit {
  width: 690rpx;
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  background-color: #5a0;
  color: #fff;
  font-size: 26rpx;
  border-radius: 40rpx;
}
