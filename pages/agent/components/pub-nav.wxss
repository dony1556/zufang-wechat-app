.menu-category-box {
  padding: 30rpx 0rpx 30rpx 0rpx;
  width: 710rpx;
  margin: 0rpx 20rpx;
  position: relative;
}
.menu-swiper-box {
  position: relative;
  background: #fff;
}
.menu-swiper-box .menu-swiper-item {
  background: #fff;
  height: 100%;
  width: 100%;
}
.menu-swiper-box .menu-tab-box {
  display: flex;
  flex-wrap: wrap;
}
.menu-swiper-box .menu-tab-box .tab-item {
  color: #333;
  padding-bottom: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
}
.menu-swiper-box .menu-tab-box .tab-item .tab-img {
  border-radius: 25rpx;
  margin-bottom: 16rpx;
  width: 90rpx;
  height: 90rpx;
}
.menu-swiper-box .menu-tab-box .tab-item .tab-text {
  font-size: 24rpx;
  font-weight: 700;
}
.menu-category-dots {
  display: flex;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 20rpx;
}
.menu-category-dots .category-dot {
  width: 36rpx;
  height: 6rpx;
  background: #eee;
  margin-right: 10rpx;
  border-radius: 6rpx;
}
.menu-category-dots .category-dot-active {
  width: 36rpx;
  height: 6rpx;
  background: red;
  margin-right: 10rpx;
  border-radius: 6rpx;
}
