.page {
  background-color: #fff;
}
.page .body-box {
  padding-top: 20rpx;
  background-color: #fff;
}
.page .body-box .swiper-box {
  height: 400rpx;
}
.page .body-box .swiper-box .slide-swiper {
  width: 100%;
  height: 400rpx;
  position: relative;
  background-color: #fff;
  margin-top: 12rpx;
}
.page .body-box .swiper-box .slide-swiper .swiper-item {
  width: 100%;
  font-size: 0;
  line-height: 0;
}
.page .body-box .swiper-box .slide-swiper .swiper-item .item {
  width: 100%;
  height: 100%;
  padding: 0 20rpx;
}
.page .body-box .swiper-box .slide-swiper .swiper-item .item .img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.page .body-box .pub-box {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 20rpx;
}
.page .body-box .pub-box .item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0rpx;
}
.page .body-box .pub-box .item .img-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .body-box .pub-box .item .name {
  margin-top: 12rpx;
  font-size: 26rpx;
}
.page .body-box .item-box {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
}
.page .body-box .item-box .item {
  display: flex;
  align-items: center;
  height: 140rpx;
  border-bottom: 1rpx solid #f5f5f5;
  padding: 0rpx 30rpx;
}
.page .body-box .item-box .item .img-box {
  margin-right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .body-box .item-box .item .left {
  display: flex;
  flex: 1;
  flex-direction: column;
}
.page .body-box .item-box .item .left .tit-1 {
  font-size: 30rpx;
}
.page .body-box .item-box .item .left .tit-2 {
  font-size: 26rpx;
  margin-top: 12rpx;
  color: silver;
}
.page .body-box .item-box .item .right {
  width: 40rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
