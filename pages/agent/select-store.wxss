.page .search-box {
  display: flex;
  justify-content: center;
  padding: 16rpx 0rpx;
}
.page .search-box .item {
  width: 650rpx;
  border-radius: 40rpx;
  height: 74rpx;
  padding-left: 30rpx;
  border: 1rpx solid #efefef;
  overflow: hidden;
  display: flex;
}
.page .search-box .item .input {
  flex: 1;
  height: 74rpx;
  font-size: 26rpx;
}
.page .search-box .item .search {
  width: 140rpx;
  height: 74rpx;
  background-color: #efefef;
  font-size: 26rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.page .store-box .store {
  background-color: #fff;
  margin: 26rpx 20rpx;
  padding: 16rpx 26rpx;
  border-radius: 12rpx;
  display: flex;
}
.page .store-box .store .img-box {
  width: 100rpx;
  height: 100rpx;
}
.page .store-box .store .img-box .img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.page .store-box .store .right {
  margin-left: 16rpx;
}
.page .store-box .store .right .name {
  font-size: 28rpx;
  font-weight: 700;
}
.page .store-box .store .right .address {
  margin-top: 16rpx;
  font-size: 24rpx;
}
