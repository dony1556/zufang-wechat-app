.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #fff;
}
.page .top-box .scroll-box {
  background-color: #fff;
  width: 100%;
  border-bottom: 1rpx solid #f7f8f9;
  position: -webkit-sticky;
  position: sticky;
}
.page .top-box .scroll-box .scroll {
  height: 90rpx;
  white-space: nowrap;
  width: 100%;
  text-align: center;
}
.page .top-box .scroll-box .scroll .item {
  height: 80rpx;
  padding: 0 40rpx;
  display: inline-block;
}
.page .top-box .scroll-box .scroll .item .name {
  height: 74rpx;
  line-height: 74rpx;
}
.page .top-box .scroll-box .scroll .item .line {
  margin-left: 30%;
  width: 40%;
  height: 6rpx;
  background-color: #f50;
  border-radius: 6rpx;
}
.page .content-box {
  flex: 1;
  overflow-y: auto;
  background-color: #f5f5f5;
}
.page .content-box .yy-box {
  width: 100%;
  padding: 0rpx 20rpx;
}
.page .content-box .yy-box .item {
  border-radius: 8rpx;
  background-color: #fff;
  padding: 20rpx;
  margin-top: 20rpx;
}
.page .content-box .yy-box .item .head {
  display: flex;
  justify-content: space-between;
  height: 60rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.page .content-box .yy-box .item .head .title {
  font-weight: 700;
  font-size: 26rpx;
}
.page .content-box .yy-box .item .content {
  padding: 20rpx 20rpx;
}
.page .content-box .yy-box .item .content .name {
  font-size: 26rpx;
}
.page .content-box .yy-box .item .content .time {
  font-size: 26rpx;
  margin-top: 20rpx;
}
.page .content-box .yy-box .item .btn-box {
  display: flex;
  justify-content: flex-end;
  padding: 12rpx 12rpx 4rpx;
}
.page .content-box .yy-box .item .btn-box .sign-btn {
  width: 160rpx;
  height: 50rpx;
  border: 1rpx solid #d7d7d7;
  border-radius: 8rpx;
  margin-right: 30rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .content-box .yy-box .item .btn-box .tel-btn {
  width: 160rpx;
  height: 50rpx;
  border: 1rpx solid #d7d7d7;
  border-radius: 8rpx;
  margin-right: 30rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .content-box .yy-box .item .btn-box .cancel-btn {
  width: 120rpx;
  height: 50rpx;
  border: 1rpx solid #d7d7d7;
  border-radius: 8rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
