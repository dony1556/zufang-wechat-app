.page .store-box {
  padding: 16rpx 20rpx;
}
.page .store-box .store {
  padding: 20rpx 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.page .store-box .store .top {
  padding: 20rpx 10rpx;
  display: flex;
}
.page .store-box .store .top .img-box {
  width: 110rpx;
  height: 110rpx;
}
.page .store-box .store .top .img-box .img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 8rpx;
}
.page .store-box .store .top .info {
  flex: 1;
  width: 0;
  margin-left: 16rpx;
}
.page .store-box .store .top .info .name {
  font-size: 28rpx;
}
.page .store-box .store .top .info .name2 {
  margin-top: 20rpx;
  font-size: 26rpx;
}
.page .footer-box {
  height: 130rpx;
  width: 100%;
}
.page .footer-box .bt {
  background: linear-gradient(45deg, #9470b0, #d5a2ff);
  color: #fff;
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 36rpx;
  border-radius: 40rpx;
  height: 78rpx;
  line-height: 78rpx;
  text-align: center;
}
