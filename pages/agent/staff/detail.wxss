.page {
  min-height: 100vh;
  background-color: #fff;
}
.page .title-box {
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .title-box .name {
  line-height: 80rpx;
  margin: 0rpx 20rpx;
}
.page .title-box .line {
  width: 220rpx;
  height: 2rpx;
  background-color: #f4f4f4;
}
.page .msg-box {
  padding: 20rpx 20rpx;
}
.page .msg-box .textarea {
  width: 100%;
  border-radius: 12rpx;
  height: 200rpx;
  border: 1rpx solid #f5f5f5;
  padding: 16rpx;
  font-size: 26rpx;
}
.page .bt-box {
  padding: 20rpx 20rpx;
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rx;
}
.page .bt-box .item {
  width: 50%;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: center;
}
.page .bt-box .item .bt {
  width: 280rpx;
  border: #f37b1d 1rpx solid;
  line-height: 78rpx;
  border-radius: 39rpx;
  color: #f37b1d;
  text-align: center;
}
.page .goods-box .item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f9f9f9;
  padding: 0rpx 30rpx;
}
.page .goods-box .item .img-box .img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
}
.page .goods-box .item .info {
  flex: 1;
  width: 0;
  margin-left: 20rpx;
}
.page .goods-box .item .info .title {
  font-size: 28rpx;
}
.page .goods-box .item .info .price {
  font-size: 26rpx;
  color: #f37b1d;
  margin-top: 16rpx;
}
.page .detail {
  font-size: 26rpx;
  padding: 20rpx 20rpx;
}
.page .order-info {
  padding: 20rpx 10rpx;
}
.page .order-info .item {
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
}
.page .order-info .item .name {
  width: 160rpx;
  font-size: 28rpx;
  line-height: 70rpx;
}
.page .order-info .item .value {
  font-weight: 700;
  font-size: 28rpx;
}
.page .footer {
  height: 100rpx;
}
.page .footer .bt-box {
  position: fixed;
  bottom: 0rpx;
  width: 100%;
  height: 100rpx;
  padding: 0rpx 20rpx;
  display: flex;
  justify-content: flex-end;
  ackground-color: #fff;
}
.page .footer .bt-box .ser {
  width: 200rpx;
  height: 78rpx;
  line-height: 78rpx;
  background-color: #ffaa7f;
  color: #fff;
  font-size: 26rpx;
  border-radius: 39rpx;
  text-align: center;
}
