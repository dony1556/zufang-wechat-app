.page {
  background-color: #fff;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page .body-box {
  flex: 1;
  overflow-y: auto;
}
.page .body-box .head {
  margin-top: 30rpx;
  padding-left: 20rpx;
}
.page .body-box .level-box {
  display: flex;
  flex-wrap: wrap;
}
.page .body-box .level-box .level {
  width: 46%;
  margin: 20rpx 2%;
  border-radius: 8rpx;
  background: #c3c3c3;
  color: #606060;
  font-size: 26rpx;
  font-weight: 700;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
}
.page .body-box .level-box .level.on {
  background: linear-gradient(90deg, #eabf8c, #fdd2a5);
  color: #000;
}
.page .body-box .detail {
  font-size: 24rpx;
  padding: 20rpx 30rpx;
}
.page .body-box .item-box {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 10rpx;
  margin-top: 20rpx;
}
.page .body-box .item-box .item {
  width: 50%;
  padding: 0rpx 20rpx;
  margin-bottom: 40rpx;
}
.page .body-box .item-box .item .item2 {
  border: 1rpx solid #d9d9d9;
  border-radius: 8rpx;
  padding: 30rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.page .body-box .item-box .item .item2.on {
  background-color: #ffd599;
  border: 1rpx solid #ffd599;
}
.page .body-box .item-box .item .item2 .name {
  font-size: 24rpx;
}
.page .body-box .item-box .item .item2 .price {
  font-size: 30rpx;
  color: #f50;
  margin-top: 20rpx;
}
.page .body-box .item-box .item .item2 .icon {
  position: absolute;
  bottom: 6rpx;
  right: 6rpx;
}
.page .body-box .log {
  font-size: 22rpx;
  color: #c9c9c9;
  text-align: center;
  margin-top: 30rpx;
}
.page .footer-box {
  background-color: #fff;
}
.page .footer-box .ok {
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: linear-gradient(90deg, #ff1f0b, #ff8317);
  color: #fff;
}
