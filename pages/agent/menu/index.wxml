<view class="page">
    <view class="top-box"></view>
    <view class="body-box">
        <view class="head"></view>
        <view class="detail">
            <text style="font-weight:bold;">权益：</text>{{'可发布'+list[menuIndex].total_pub_num+'条房源信息,'}}</view>
        <view class="item-box">
            <view class="item" wx:for="{{list}}" wx:for-index="index2" wx:for-item="item2" wx:key="*this">
                <view bindtap="__e" class="{{['item2',menuIndex==index2?'on':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectMenu',[index2] ] ] ] ]}}">
                    <view class="name">{{item2.name+'('+item2.day+'天)'}}</view>
                    <view class="price">{{'¥'+item2.price}}</view>
                </view>
            </view>
        </view>
        <view bindtap="__e" class="log" data-event-opts="{{[ [ 'tap',[ [ 'navToLog',['$event'] ] ] ] ]}}">购买明细</view>
        <view class="detail">
            <text style="font-weight:bold;">说明：</text>
            <text>{{agent_set.vip_remark}}</text>
        </view>
    </view>
    <view class="footer-box">
        <view bindtap="__e" class="ok" data-event-opts="{{[ [ 'tap',[ [ 'formHandle',['$event'] ] ] ] ]}}">购买</view>
    </view>
    <wk-login-modal bind:__l="__l" vueId="31bc247e-1"></wk-login-modal>
</view>
