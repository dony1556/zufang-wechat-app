<view class="page">
    <view class="swiper-box">
        <swiper autoplay="true" class="slide-swiper">
            <swiper-item class="swiper-item" wx:for="{{swiperList}}" wx:key="index">
                <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'navto',['$event'] ] ] ] ]}}">
                    <image class="img" mode="aspectFill" src="{{item.img}}"></image>
                </view>
            </swiper-item>
        </swiper>
    </view>
    <view class="form">
        <view style="border-radius:12rpx;overflow:hidden;background-color:#FFFFFF;">
            <view class="form-item">
                <view class="title">姓名</view>
                <view class="right">
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','name','$event',[] ],['agent'] ] ] ] ]}}" placeholder="请填写真实姓名" value="{{agent.name}}"></input>
                </view>
            </view>
            <view class="form-item">
                <view class="title">手机号码</view>
                <view class="right">
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','tel','$event',[] ],['agent'] ] ] ] ]}}" placeholder="请填写手机号码" value="{{agent.tel}}"></input>
                </view>
            </view>
            <view class="form-item">
                <text class="title">从业年限</text>
                <view class="right">
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','work_year','$event',[] ],['agent'] ] ] ] ]}}" placeholder="请输入从业年限" type="number" value="{{agent.work_year}}"></input>
                </view>
            </view>
            <view class="form-item">
                <view class="title">标签</view>
                <view class="right">
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','label','$event',[] ],['agent'] ] ] ] ]}}" placeholder="多个标签用空格隔开" value="{{agent.label}}"></input>
                </view>
            </view>
            <view bindtap="__e" class="form-item" data-event-opts="{{[ [ 'tap',[ [ 'openArea',['$event'] ] ] ] ]}}">
                <text class="title">主营地区</text>
                <view class="right">
                    <view class="choose-box">
                        <view class="text">{{agent.area_name||'请选择所在地区'}}</view>
                        <view class="iconfont icon-you icon "></view>
                    </view>
                </view>
            </view>
            <view bindtap="__e" class="form-item" data-event-opts="{{[ [ 'tap',[ [ 'openStore',['$event'] ] ] ] ]}}">
                <text class="title">所属门店</text>
                <view class="right">
                    <view class="choose-box">
                        <view class="text">{{store.name||'请选择所属门店'}}</view>
                        <view class="iconfont icon-you icon "></view>
                    </view>
                </view>
            </view>
            <view class="form-item">
                <text class="title">头像</text>
                <view class="right">
                    <view class="img-box">
                        <view class="preview-box" wx:for="{{agent.logo}}" wx:key="index">
                            <image class="preview-img" mode="aspectFill" src="{{item}}"></image>
                            <text bindtap="__e" class="cuIcon-close" data-event-opts="{{[ [ 'tap',[ [ 'delImg',['$0',index],['agent.logo'] ] ] ] ]}}"></text>
                        </view>
                        <view bindtap="__e" class="choose-img " data-event-opts="{{[ [ 'tap',[ [ 'onChooseImg',['$0',1],['agent.logo'] ] ] ] ]}}" wx:if="{{$root.g0<1}}">
                            <text class="cuIcon-cameraadd"></text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
        <view style="padding:10rpx 20rpx;background-color:#FFFFFF;border-bottom:1rpx solid rgba(223, 223, 223, 0.5);">
            <text style="line-height:80rpx;font-size:26rpx;">身份证、工作证件</text>
            <view class="bot-box">
                <view class="img-box">
                    <view class="preview-box" wx:for="{{agent.card_imgs}}" wx:key="index">
                        <image class="preview-img" mode="aspectFill" src="{{item}}"></image>
                        <text bindtap="__e" class="cuIcon-close" data-event-opts="{{[ [ 'tap',[ [ 'delImg',['$0',index],['agent.card_imgs'] ] ] ] ]}}"></text>
                    </view>
                    <view bindtap="__e" class="choose-img " data-event-opts="{{[ [ 'tap',[ [ 'onChooseImg',['$0',9],['agent.card_imgs'] ] ] ] ]}}" wx:if="{{$root.g1<9}}">
                        <text class="cuIcon-cameraadd"></text>
                    </view>
                </view>
            </view>
        </view>
        <view style="border-radius:12rpx;overflow:hidden;background-color:#FFFFFF;margin-top:16rpx;">
            <view class="treaty">
                <view bindtap="__e" class="iconfont icon-gouxuan" data-event-opts="{{[ [ 'tap',[ [ 'handTreaty',['$event'] ] ] ] ]}}" style="font-size:36rpx;color:#ff5500;" wx:if="{{treaty_agree}}"></view>
                <view bindtap="__e" class="iconfont icon-gouxuan1" data-event-opts="{{[ [ 'tap',[ [ 'handTreaty',['$event'] ] ] ] ]}}" style="font-size:36rpx;color:#c3c3c3;" wx:if="{{!treaty_agree}}"></view>
                <view class="txt">我已经阅读并了解<text bindtap="__e" data-event-opts="{{[ [ 'tap',[ [ 'navToTreaty',['$event'] ] ] ] ]}}" style="color:#014c8c;">【经纪人申请协议】</text>
                </view>
            </view>
        </view>
    </view>
    <form bindsubmit="__e" data-event-opts="{{[ [ 'submit',[ [ 'formSubmit',['$event'] ] ] ] ]}}">
        <button class="submit" formType="submit" type="primary">申请成为经纪人</button>
    </form>
    <wk-city-area2 bind:__l="__l" bind:onConfirm="__e" class="vue-ref" data-event-opts="{{[ [ '^onConfirm',[ ['areaConfirm'] ] ] ]}}" data-ref="areaSelect" vueId="5d7c3120-1"></wk-city-area2>
</view>
