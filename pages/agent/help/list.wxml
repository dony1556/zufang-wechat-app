<view class="page">
    <view class="help-box">
        <view bindtap="__e" class="help" data-event-opts="{{[ [ 'tap',[ [ 'toDetail',['$0'],[ [ ['list','',index,'id'] ] ] ] ] ] ]}}" wx:for="{{list}}" wx:key="index">
            <view class="name">{{item.problem_title}}</view>
        </view>
    </view>
</view>
