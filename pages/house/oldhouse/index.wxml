<view class="page">
    <view class="top-box" style="height:1rpx;"></view>
    <view class="content-box">
        <view bindtap="__e" class="search-box" data-event-opts="{{[ [ 'tap',[ [ 'toSearch',['$event'] ] ] ] ]}}">
            <view class="iconfont icon-search  icon"></view>
            <view class="text">请输入小区关键字搜索</view>
        </view>
        <view class="swiper-box" wx:if="{{$root.g0>0}}">
            <swiper autoplay="true" class="slide-swiper">
                <swiper-item class="swiper-item" wx:for="{{swiperList}}" wx:key="index">
                    <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'navto',['$event'] ] ] ] ]}}">
                        <image class="img" mode="aspectFill" src="{{item.img}}"></image>
                    </view>
                </swiper-item>
            </swiper>
        </view>
        <view class="select-house">
            <view bindtap="__e" class="back-shadow" data-event-opts="{{[ [ 'tap',[ [ 'close',['$event'] ] ] ] ]}}" wx:if="{{selectshow}}"></view>
            <view class="{{[selectshow?'slect-box-active':'slect-box']}}">
                <view class="item-box">
                    <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'selectTab',[0] ] ] ] ]}}">
                        <view class="{{['tit','',select_p.area_id>0||select_p.dt_line_id>0||select_p.dt_station_id>0?'active':'']}}">{{select_p.headArea||'区域'}}</view>
                        <view class="{{['iconfont','icon-16_shixinxiangxia','icon',select_p.area_id>0?'active':'']}}"></view>
                    </view>
                    <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'selectTab',[1] ] ] ] ]}}">
                        <view class="{{['tit','','',select_p.money_index>=0?'active':'']}}">{{select_p.headPrice||'售价'}}</view>
                        <view class="{{['iconfont','icon-16_shixinxiangxia','icon',select_p.money_index>=0?'active':'']}}"></view>
                    </view>
                    <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'selectTab',[2] ] ] ] ]}}">
                        <block wx:if="{{$root.g1>0}}">
                            <view class="tit active">{{select_p.headShi}}</view>
                            <view class="iconfont icon-16_shixinxiangxia  icon active"></view>
                        </block>
                        <block wx:else>
                            <view class="tit">{{select_p.headShi}}</view>
                            <view class="iconfont icon-16_shixinxiangxia icon"></view>
                        </block>
                    </view>
                    <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'selectTab',[3] ] ] ] ]}}">
                        <block wx:if="{{$root.g2}}">
                            <view class="tit active">{{select_p.headMore}}</view>
                            <view class="iconfont icon-16_shixinxiangxia icon active "></view>
                        </block>
                        <block wx:else>
                            <view class="tit">{{select_p.headMore}}</view>
                            <view class="iconfont icon-16_shixinxiangxia  icon"></view>
                        </block>
                    </view>
                </view>
                <block wx:if="{{selectshow}}">
                    <view class="choose-box">
                        <view class="area-box" wx:if="{{itemIndex==0}}">
                            <scroll-view class="left " scrollY="{{true}}">
                                <view bindtap="__e" class="{{['item',select_p2.areaType==1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectDq',['$event'] ] ] ] ]}}">区域</view>
                                <!-- <view bindtap="__e" class="{{['item',select_p2.areaType==2?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectDt',['$event'] ] ] ] ]}}">地铁</view> -->
                            </scroll-view>
                            <block wx:if="{{select_p2.areaType==1}}">
                                <scroll-view class="between " scrollY="{{true}}">
                                    <view bindtap="__e" class="{{['item',select_p2.area_id==item.id?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectArea',[index] ] ] ] ]}}" wx:for="{{areaList}}" wx:key="index">{{''+item.name+''}}</view>
                                </scroll-view>
                                <scroll-view class="right" scrollY="true" wx:if="{{select_p2.area_id>0}}">
                                    <view bindtap="__e" class="{{['item',item.g3>-1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectBuildarea',[index] ] ] ] ]}}" wx:for="{{$root.l0}}" wx:key="index">{{''+item.$orig.name+''}}</view>
                                </scroll-view>
                            </block>
                            <block wx:if="{{select_p2.areaType==2}}">
                                <scroll-view class="between " scrollY="{{true}}">
                                    <view bindtap="__e" class="{{['item',select_p2.dt_line_id==item.id?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectDtLine',[index] ] ] ] ]}}" wx:for="{{dtList}}" wx:key="index">{{''+item.name+''}}</view>
                                </scroll-view>
                                <scroll-view class="right" scrollY="true" wx:if="{{select_p2.dt_line_id>0}}">
                                    <view bindtap="__e" class="{{['item',select_p2.dt_station_id==item.id?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'selectDtStation',[index] ] ] ] ]}}" wx:for="{{dtStationList}}" wx:key="index">{{''+item.name+''}}</view>
                                </scroll-view>
                            </block>
                        </view>
                        <view class="price-box" wx:if="{{itemIndex==1}}">
                            <scroll-view class="select-price" scrollY="{{true}}">
                                <view bindtap="__e" class="{{['price-item',index==select_p2.money_index?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'choosePrice',[index] ] ] ] ]}}" wx:for="{{priceList}}" wx:key="index">{{item.name}}</view>
                            </scroll-view>
                        </view>
                        <view class="shi-box" wx:if="{{itemIndex==2}}">
                            <view class="title">户型</view>
                            <view class="shis">
                                <view bindtap="__e" class="{{['shi-item',item.g4>-1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseShi',[index] ] ] ] ]}}" wx:for="{{$root.l1}}" wx:key="index">{{item.$orig.name}}</view>
                            </view>
                        </view>
                        <view class="more-box" wx:if="{{itemIndex==3}}">
                            <scroll-view class="more-scroll" scrollY="true">
                                <view class="title">来源</view>
                                <view class="more-item">
                                    <view bindtap="__e" class="{{['option',item.g5>-1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseOrigin',[index] ] ] ] ]}}" wx:for="{{$root.l2}}" wx:key="index">{{item.$orig.name}}</view>
                                </view>
                                <view class="title">朝向</view>
                                <view class="more-item">
                                    <view bindtap="__e" class="{{['option',item.g6>-1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseDirection',[index] ] ] ] ]}}" wx:for="{{$root.l3}}" wx:key="index">{{item.$orig.name}}</view>
                                </view>
                                <view class="title">类型</view>
                                <view class="more-item">
                                    <view bindtap="__e" class="{{['option',item.g7>-1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseType2',[index] ] ] ] ]}}" wx:for="{{$root.l4}}" wx:key="index">{{item.$orig.name}}</view>
                                </view>
                                <view class="title">装修</view>
                                <view class="more-item">
                                    <view bindtap="__e" class="{{['option',item.g8>-1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseDecorate',[index] ] ] ] ]}}" wx:for="{{$root.l5}}" wx:key="index">{{item.$orig.name}}</view>
                                </view>
                                <view class="title">面积</view>
                                <view class="more-item">
                                    <view bindtap="__e" class="{{['option',index==select_p2.mj_index?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseMj2',[index] ] ] ] ]}}" wx:for="{{mjList}}" wx:key="index">{{item.name}}</view>
                                </view>
                                <view class="title">标签</view>
                                <view class="more-item">
                                    <view bindtap="__e" class="{{['option',item.g9>-1?'active':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'chooseTag',[index] ] ] ] ]}}" wx:for="{{$root.l6}}" wx:key="index">{{item.$orig.name}}</view>
                                </view>
                            </scroll-view>
                        </view>
                    </view>
                    <view class="bottom-box">
                        <view catchtap="__e" class="clear" data-event-opts="{{[ [ 'tap',[ [ 'clear',['$event'] ] ] ] ]}}">重置</view>
                        <view catchtap="__e" class="confirm" data-event-opts="{{[ [ 'tap',[ [ 'confirm',['$event'] ] ] ] ]}}">确定</view>
                    </view>
                </block>
            </view>
        </view>
        <view class="house-box">
            <wk-houses bind:__l="__l" value="{{houseList}}" vueId="6c408fa2-1"></wk-houses>
        </view>
    </view>
    <wk-skeletons bind:__l="__l" type="detail" vueId="6c408fa2-2" wx:if="{{isLoading}}"></wk-skeletons>
</view>
