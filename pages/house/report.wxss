.page {
  background-color: #fff;
  width: 100%;
  min-height: 100vh;
}
.page .body-box .head {
  height: 100rpx;
  line-height: 100rpx;
  padding: 0rpx 30rpx;
  font-size: 26rpx;
  font-weight: 700;
}
.page .body-box .item-box {
  padding: 10rpx 12rpx;
}
.page .body-box .item-box .item {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  height: 110rpx;
  border-top: 1rpx solid #f4f4f4;
}
.page .body-box .item-box .item .name {
  flex: 1;
  font-size: 26rpx;
  margin-left: 20rpx;
  height: 100rpx;
  line-height: 100rpx;
}
.page .body-box .btn-box {
  margin-top: 30rpx;
  height: 80rpx;
  line-height: 80rpx;
  width: 690rpx;
  margin-left: 30rpx;
  background: linear-gradient(-90deg, #f50, #ff557f);
  color: #fff;
  border-radius: 8rpx;
  text-align: center;
}
