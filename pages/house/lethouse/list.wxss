.page {
  background-color: #fff;
}
.page .top-box .select-house {
  position: -webkit-sticky;
  position: sticky;
  top: 0rpx;
  background-color: #fff;
  z-index: 999;
}
.page .top-box .select-house .back-shadow {
  position: fixed;
  left: 0;
  width: 100%;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 9999;
  opacity: 1;
}
.page .top-box .select-house .slect-box {
  background-color: #fff;
  padding: 0 12rpx;
  z-index: 9999999;
}
.page .top-box .select-house .slect-box-active {
  position: fixed;
  top: 0rpx;
  left: 0rpx;
  width: 100%;
  z-index: 99999999;
  background-color: #fff;
  padding: 0 12rpx;
}
.page .top-box .select-house .item-box {
  display: flex;
}
.page .top-box .select-house .item-box .item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100rpx;
}
.page .top-box .select-house .item-box .item .tit {
  font-size: 26rpx;
}
.page .top-box .select-house .item-box .item .tit.active {
  color: #3dbcc5;
}
.page .top-box .select-house .item-box .item .icon {
  font-size: 20rpx;
  color: #a2a2a2;
  margin-left: 8rpx;
}
.page .top-box .select-house .item-box .item .icon.active {
  color: #3dbcc5;
}
.page .content-box {
  position: relative;
}
