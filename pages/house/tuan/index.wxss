.page {
  background-color: #fff;
  width: 100%;
}
.page .swiper-box {
  height: 400rpx;
}
.page .swiper-box .slide-swiper {
  width: 100%;
  height: 400rpx;
  position: relative;
  background-color: #fff;
  margin-top: 12rpx;
}
.page .swiper-box .slide-swiper .swiper-item {
  width: 100%;
  font-size: 0;
  line-height: 0;
}
.page .swiper-box .slide-swiper .swiper-item .item {
  width: 100%;
  height: 100%;
  padding: 0 20rpx;
  border-radius: 12rpx;
}
.page .swiper-box .slide-swiper .swiper-item .item .img {
  width: 100%;
  height: 100%;
}
.page .tuan-box {
  padding: 20rpx 32rpx;
}
.page .tuan-box .item {
  display: felx;
  flex-direction: column;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 2rpx 2rpx 10rpx #e3e3e3;
}
.page .tuan-box .item .img-box {
  width: 100%;
  height: 500rpx;
  position: relative;
}
.page .tuan-box .item .img-box .img {
  width: 100%;
  height: 100%;
}
.page .tuan-box .item .img-box .status {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  border-radius: 30rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  color: #fff;
  padding: 0rpx 30rpx;
  font-size: 26rpx;
  box-shadow: 4rpx 4rpx 6rpx #999;
}
.page .tuan-box .item .title-box {
  padding: 16rpx 16rpx;
}
.page .tuan-box .item .title-box .title {
  font-size: 28rpx;
}
.page .tuan-box .item .title-box .time {
  font-size: 24rpx;
  color: #cdcdcd;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.page .footer-box {
  width: 100%;
}
