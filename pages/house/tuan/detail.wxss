.page {
  background-color: #fff;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.page .content-box {
  flex: 1;
  overflow-y: auto;
}
.page .content-box .swiper-box {
  width: 100%;
  height: 550rpx;
  position: relative;
}
.page .content-box .swiper-box .carousel {
  width: 100%;
  height: 550rpx;
}
.page .content-box .swiper-box .carousel .carousel-item {
  width: 100%;
  height: 550rpx;
}
.page .content-box .swiper-box .carousel .carousel-item .img {
  width: 100%;
  height: 100%;
}
.page .content-box .swiper-box .label-box {
  position: absolute;
  bottom: 18rpx;
  left: 18rpx;
  width: 90%;
  display: flex;
}
.page .content-box .swiper-box .label-box .label {
  margin-right: 13rpx;
  padding: 0 14rpx;
  line-height: 32rpx;
  color: #fff;
  font-size: 20rpx;
}
.page .content-box .swiper-box .label-box .label.active {
  background: #fff;
  color: #333;
  border: #fff;
  border-radius: 100rpx;
}
.page .content-box .swiper-box .num-box {
  position: absolute;
  right: 30rpx;
  bottom: 20rpx;
  color: #fff;
  font-size: 20rpx;
  width: 43rpx;
  height: 28rpx;
}
.page .content-box .title2 {
  padding: 16rpx 20rpx;
}
.page .content-box .time2 {
  font-size: 26rpx;
  padding: 16rpx 20rpx;
}
.page .content-box .detail-box {
  padding: 20rpx 20rpx;
  background-color: #fff;
}
.page .content-box .detail-box .head {
  font-size: 28rpx;
  font-weight: 700;
}
.page .content-box .detail-box .detail {
  padding: 20rpx 10rpx;
  font-size: 26rpx;
}
.page .content-box .house-box {
  background-color: #fff;
}
.page .content-box .house-box .title-box {
  width: 100%;
  padding: 20rpx 30rpx;
}
.page .content-box .house-box .title-box .title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.page .content-box .house-box .content {
  width: 100%;
  padding: 20rpx 0rpx;
  border-radius: 10rpx;
}
.page .footer-box {
  width: 100%;
  height: 110rpx;
  z-index: 99;
}
.page .footer-box .bot2 {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: center;
  background-color: #fff;
  z-index: 10;
  border-top: 1rpx solid #eee;
}
.page .footer-box .bot2 .nav2 {
  width: 250rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.page .footer-box .bot2 .nav2 .text {
  font-size: 23rpx;
  margin-top: 10rpx;
}
.page .footer-box .bot2 .btn-box {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 50rpx;
}
.page .footer-box .bot2 .btn-box .call2 {
  text-align: center;
  line-height: 76rpx;
  color: #fff;
  width: 200rpx;
  background-color: #05b702;
  border-top-left-radius: 40rpx;
  border-bottom-left-radius: 40rpx;
  font-size: 26rpx;
}
.page .footer-box .bot2 .btn-box .yy2 {
  text-align: center;
  line-height: 76rpx;
  color: #fff;
  width: 200rpx;
  background-color: #9cf;
  border-top-right-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  font-size: 26rpx;
}
