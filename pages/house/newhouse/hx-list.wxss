.page {
  background-color: #fff;
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.page .content-box {
  flex: 1;
  overflow-y: auto;
}
.page .content-box .item {
  display: flex;
  width: 100%;
  background-color: #fff;
  padding: 32rpx 30rpx;
  margin-top: 4rpx;
}
.page .content-box .item .img-box {
  width: 250rpx;
  height: 180rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}
.page .content-box .item .img-box .img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.page .content-box .item .img-box .video-btn {
  position: absolute;
  font-size: 36rpx;
  color: #fff;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}
.page .content-box .info {
  display: flex;
  flex-direction: column;
}
.page .content-box .info .title {
  display: flex;
}
.page .content-box .info .title .shi {
  font-size: 26rpx;
}
.page .content-box .info .title .sale_status {
  background: linear-gradient(45deg, #5af, #66deff);
  margin-left: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #fff;
}
.page .content-box .info .mj {
  font-size: 26rpx;
  margin-top: 10rpx;
}
.page .content-box .info .price {
  color: red;
  font-size: 26rpx;
  margin-top: 10rpx;
}
