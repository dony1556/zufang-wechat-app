.page {
  background-color: #fff;
  width: 100%;
}
.page .top-box {
  display: flex;
}
.page .content-box .scroll-box {
  width: 100%;
  height: calc(100vh - 120rpx);
}
.page .content-box .swiper-box {
  width: 100%;
  height: 550rpx;
  position: relative;
}
.page .content-box .swiper-box .carousel {
  width: 100%;
  height: 550rpx;
}
.page .content-box .swiper-box .carousel .carousel-item {
  width: 100%;
  height: 550rpx;
}
.page .content-box .swiper-box .carousel .carousel-item .img {
  width: 100%;
  height: 100%;
}
.page .content-box .swiper-box .carousel .carousel-item .vr {
  width: 140rpx;
  height: 140rpx;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
.page .content-box .swiper-box .label-box {
  position: absolute;
  bottom: 18rpx;
  left: 18rpx;
  width: 90%;
  display: flex;
}
.page .content-box .swiper-box .label-box .label {
  margin-right: 13rpx;
  padding: 0 14rpx;
  line-height: 32rpx;
  color: #fff;
  font-size: 20rpx;
}
.page .content-box .swiper-box .label-box .label.active {
  background: #fff;
  color: #333;
  border: #fff;
  border-radius: 100rpx;
}
.page .content-box .swiper-box .video {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.page .content-box .swiper-box .video-close {
  position: absolute;
  right: 40rpx;
  top: 160rpx;
  font-size: 40rpx;
  color: #fff;
  z-index: 999;
}
.page .content-box .swiper-box .type-box {
  position: absolute;
  left: 100rpx;
  width: 550rpx;
  bottom: 50rpx;
  color: #fff;
  font-size: 20rpx;
  height: 28rpx;
  display: flex;
  justify-content: center;
}
.page .content-box .swiper-box .type-box .item {
  margin-right: 16rpx;
  width: 86rpx;
  height: 42rpx;
  font-size: 20rpx;
  background-color: #fff;
  border-radius: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #8d9292;
}
.page .content-box .swiper-box .type-box .item.on {
  color: #fff;
  background-color: red;
}
.page .content-box .swiper-box .num-box {
  position: absolute;
  right: 30rpx;
  bottom: 20rpx;
  color: #fff;
  font-size: 20rpx;
  width: 43rpx;
  height: 28rpx;
}
.page .content-box .box-1 {
  padding: 16rpx 30rpx;
  border-bottom: 8rpx solid #f7f8f9;
}
.page .content-box .box-1 .title-box {
  display: flex;
  width: 100%;
}
.page .content-box .box-1 .title-box .img {
  width: 32rpx;
  height: 32rpx;
}
.page .content-box .box-1 .title-box .title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 40rpx;
  flex: 1;
  width: 0;
  font-weight: 700;
}
.page .content-box .box-1 .title-box .share {
  width: 80rpx;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.page .content-box .box-1 .title-box .share .text {
  font-size: 20rpx;
  color: #999;
}
.page .content-box .box-1 .pirce-box {
  display: flex;
  align-items: center;
}
.page .content-box .box-1 .pirce-box .name {
  font-size: 26rpx;
}
.page .content-box .box-1 .pirce-box .price {
  font-size: 26rpx;
  color: #f50;
  font-weight: 700;
}
.page .content-box .box-1 .lb-box {
  display: flex;
  margin-top: 10rpx;
  flex-wrap: wrap;
}
.page .content-box .box-1 .lb-box .lb {
  border: 2rpx solid rgba(83, 190, 191, 0.5);
  font-size: 20rpx;
  color: #3dbcc6;
  padding: 4rpx 18rpx;
  margin-right: 16rpx;
  margin-bottom: 14rpx;
  border-radius: 6rpx;
}
.page .content-box .info-box {
  padding: 25rpx 26rpx 25rpx 26rpx;
  border-bottom: 1px solid #edeeef;
  background-color: #fff;
}
.page .content-box .info-box .head {
  font-size: 32rpx;
  color: #333;
  font-weight: 700;
}
.page .content-box .info-box .des-box {
  margin-top: 25rpx;
  padding: 0 15rpx;
  display: flex;
  flex-wrap: wrap;
}
.page .content-box .info-box .des-box .des {
  width: 50%;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  line-height: 68rpx;
}
.page .content-box .info-box .des-box .des .left {
  color: #8d9292;
  font-size: 24rpx;
}
.page .content-box .info-box .des-box .des .right {
  color: #666;
  font-size: 24rpx;
}
.page .content-box .info-box .address {
  display: flex;
  align-items: center;
  padding: 0 25rpx;
  margin-top: 12rpx;
}
.page .content-box .info-box .address .title {
  color: #8d9292;
  font-size: 24rpx;
}
.page .content-box .info-box .address .name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 24rpx;
}
.page .content-box .info-box .address .icon {
  font-size: 30rpx;
  color: #3dbcc6;
}
.page .content-box .info-box .more-box {
  margin: 30rpx 10rpx 20rpx 10rpx;
  background-color: #f3f2ff;
  border-radius: 10rpx;
  line-height: 80rpx;
  text-align: center;
  color: #55f;
  font-size: 26rpx;
}
.page .content-box .hx-box {
  display: flex;
  flex-direction: column;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f9f9f9;
}
.page .content-box .hx-box .head-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page .content-box .hx-box .head-box .title {
  font-size: 28rpx;
  font-weight: 700;
}
.page .content-box .hx-box .head-box .more {
  font-size: 24rpx;
  color: #c3c3c3;
}
.page .content-box .hx-box .content {
  width: 100%;
  margin-top: 20rpx;
}
.page .content-box .hx-box .content .scroll {
  width: 100%;
  white-space: nowrap;
}
.page .content-box .hx-box .content .scroll .scroll-item {
  position: relative;
  display: inline-block;
  width: 260rpx;
}
.page .content-box .hx-box .content .scroll .scroll-item .img {
  width: 240rpx;
  height: 200rpx;
  border-radius: 10rpx;
}
.page .content-box .hx-box .content .scroll .scroll-item .info {
  display: flex;
  flex-direction: column;
}
.page .content-box .hx-box .content .scroll .scroll-item .info .title {
  display: flex;
  margin-top: 10rpx;
}
.page .content-box .hx-box .content .scroll .scroll-item .info .title .shi {
  font-size: 26rpx;
}
.page
  .content-box
  .hx-box
  .content
  .scroll
  .scroll-item
  .info
  .title
  .sale_status {
  background: linear-gradient(45deg, #5af, #66deff);
  margin-left: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #fff;
}
.page .content-box .hx-box .content .scroll .scroll-item .info .mj {
  font-size: 24rpx;
  margin-top: 10rpx;
}
.page .content-box .hx-box .content .scroll .scroll-item .info .price {
  color: red;
  font-size: 24rpx;
  margin-top: 10rpx;
}
.page .content-box .detail-box {
  display: flex;
  flex-direction: column;
  padding: 20rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #edeeef;
}
.page .content-box .detail-box .head {
  font-weight: 700;
}
.page .content-box .detail-box .content {
  padding: 20rpx 10rpx;
  font-size: 24rpx;
}
.page .content-box .near-box {
  display: flex;
  flex-direction: column;
  background-color: #fff;
}
.page .content-box .near-box .title-box {
  width: 100%;
  padding: 20rpx 30rpx;
}
.page .content-box .near-box .title-box .title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.page .content-box .near-box .content {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 10rpx 0rpx;
}
.page .content-box .no-ze {
  background-color: #fff;
  margin-top: 12rpx;
  padding-bottom: 30rpx;
}
.page .content-box .no-ze .top-box {
  width: 100%;
  padding: 12rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.page .content-box .no-ze .top-box .title {
  font-size: 28rpx;
  color: #333;
}
.page .content-box .no-ze .top-box .report {
  font-size: 24rpx;
  border: 1rpx solid #e3e3e3;
  padding: 4rpx 20rpx;
  border-radius: 4rpx;
}
.page .content-box .no-ze .content {
  display: flex;
  width: 100%;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
}
.footer-box {
  width: 100%;
  height: 110rpx;
  z-index: 99;
}
.footer-box .bot2 {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: center;
  background-color: #fff;
  z-index: 10;
  border-top: 1rpx solid #eee;
}
.footer-box .bot2 .nav2 {
  width: 110rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.footer-box .bot2 .nav2 .text {
  font-size: 23rpx;
  margin-top: 10rpx;
}
.footer-box .bot2 .btn-box {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}
.footer-box .bot2 .btn-box .call2 {
  text-align: center;
  line-height: 72rpx;
  color: #fff;
  width: 200rpx;
  background-color: #05b702;
  border-top-left-radius: 40rpx;
  border-bottom-left-radius: 40rpx;
  font-size: 26rpx;
}
.footer-box .bot2 .btn-box .yy2 {
  text-align: center;
  line-height: 72rpx;
  color: #fff;
  width: 200rpx;
  background-color: #9cf;
  border-top-right-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  font-size: 26rpx;
}
