.page .swiper-box {
  height: 400rpx;
}
.page .swiper-box .slide-swiper {
  width: 100%;
  height: 400rpx;
  position: relative;
  background-color: #fff;
}
.page .swiper-box .slide-swiper .swiper-item {
  width: 100%;
  font-size: 0;
  line-height: 0;
}
.page .swiper-box .slide-swiper .swiper-item .item {
  width: 100%;
  height: 100%;
}
.page .swiper-box .slide-swiper .swiper-item .item .img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.page .form {
  margin: 12rpx 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 10rpx;
}
.page .form .item {
  border-bottom: 1rpx solid #f8f8f8;
  padding: 16rpx 16rpx;
}
.page .form .item .title {
  font-size: 28rpx;
  line-height: 60rpx;
}
.page .form .item .input-box .input {
  height: 80rpx;
  line-height: 80rpx;
  width: 100%;
  font-size: 26rpx;
}
.page .form .form-item {
  width: 100%;
  padding: 10rpx 20rpx;
  display: flex;
  border-bottom: 1rpx solid #f3f3f3;
}
.page .form .form-item .title {
  width: 180rpx;
  min-height: 90rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.page .form .form-item .right {
  flex: 1;
  display: flex;
  align-items: center;
}
.page .form .form-item .right .radio-group {
  display: flex;
}
.page .form .form-item .right .radio-group .label {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
}
.page .form .form-item .right .radio-group .label .radio {
  transform: scale(0.7);
}
.page .form .form-item .right .radio-group .label .name {
  margin-left: 10rpx;
  font-size: 26rpx;
}
.page .form .form-item .right .choose-box {
  width: 100%;
  display: flex;
  flex: 1;
  align-items: center;
  height: 90rpx;
}
.page .form .form-item .right .choose-box .text {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 24rpx;
  width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.page .form .form-item .right .choose-box .icon {
  font-size: 30rpx;
  color: #c4c4c4;
  margin-right: 10rpx;
}
.page .form .form-item .right .img-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.page .form .form-item .right .img-box .choose-img,
.page .form .form-item .right .img-box .preview-box {
  width: 90rpx;
  height: 90rpx;
  background: #f9fafb;
  border: 1rpx solid #efefef;
  margin-right: 25rpx;
  margin-bottom: 25rpx;
  position: relative;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .form .form-item .right .img-box .choose-img:nth-child(5n),
.page .form .form-item .right .img-box .preview-box:nth-child(5n) {
  margin-right: 0;
}
.page .form .form-item .right .img-box .choose-img .cuIcon-cameraadd,
.page .form .form-item .right .img-box .preview-box .cuIcon-cameraadd {
  font-size: 42rpx;
  color: #e9e9e9;
}
.page .form .form-item .right .img-box .choose-img .preview-img,
.page .form .form-item .right .img-box .preview-box .preview-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.page .form .form-item .right .img-box .choose-img .preview-video,
.page .form .form-item .right .img-box .preview-box .preview-video {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.page .form .form-item .right .img-box .choose-img .cuIcon-close,
.page .form .form-item .right .img-box .preview-box .cuIcon-close {
  background: linear-gradient(90deg, #f50, #ffd387);
  border-radius: 50%;
  width: 36rpx;
  line-height: 36rpx;
  color: #fff;
  text-align: center;
  position: absolute;
  top: -10rpx;
  right: -10rpx;
}
.page .form .form-item .right .picker {
  width: 100%;
}
.page .form .form-item .right .picker .picker-box {
  height: 90rpx;
  width: 100%;
  display: flex;
  align-items: center;
}
.page .form .form-item .right .picker .picker-box .text {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 26rpx;
}
.page .form .form-item .right .picker .picker-box .icon {
  font-size: 30rpx;
  color: #c4c4c4;
  margin-right: 10rpx;
}
.page .form .form-item .right .input {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 26rpx;
}
.page .form .form-item .right .unit {
  padding: 0 10rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 22rpx;
  color: #a0a0a0;
}
.page .form .treaty {
  display: flex;
  align-items: center;
  padding: 26rpx 20rpx;
}
.page .form .treaty .txt {
  margin-left: 16rpx;
  font-size: 28rpx;
}
.page .add {
  height: 78rpx;
  width: 560rpx;
  border-radius: 40rpx;
  margin: 30rpx auto 0;
  color: #fff;
  font-size: 28rpx;
  line-height: 80rpx;
  background: linear-gradient(45deg, #9470b0, #d5a2ff);
  text-align: center;
}
