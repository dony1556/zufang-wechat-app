.page .scroll-box {
  background-color: #fff;
  width: 100%;
  border-bottom: 1rpx solid #f7f8f9;
  position: -webkit-sticky;
  position: sticky;
}
.page .scroll-box .scroll {
  height: 80rpx;
  white-space: nowrap;
  width: 100%;
  text-align: center;
}
.page .scroll-box .scroll .item {
  height: 80rpx;
  padding: 0 50rpx;
  display: inline-block;
  width: 50%;
}
.page .scroll-box .scroll .item .name {
  height: 72rpx;
  line-height: 72rpx;
}
.page .scroll-box .scroll .item .name.active {
  color: #f50;
}
.page .scroll-box .scroll .item .line {
  margin-left: 30%;
  width: 40%;
  height: 2rpx;
  background-color: #f50;
  border-radius: 6rpx;
}
