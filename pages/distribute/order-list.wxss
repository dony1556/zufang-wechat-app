.page .yy-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  padding: 0rpx 20rpx;
}
.page .yy-box .item {
  display: flex;
  flex-direction: column;
  border-radius: 8rpx;
  background-color: #fff;
  padding: 20rpx 20rpx;
  margin-top: 20rpx;
}
.page .yy-box .item .head {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f8f8f8;
}
.page .yy-box .item .head .name {
  font-weight: 700;
  font-size: 26rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 66rpx;
}
.page .yy-box .item .head .status {
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #f50;
}
.page .yy-box .item .info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0rpx;
}
.page .yy-box .item .info .user {
  display: flex;
  align-items: center;
}
.page .yy-box .item .info .user .img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 6rpx;
}
.page .yy-box .item .info .user .name {
  font-size: 28rpx;
  margin-left: 12rpx;
}
.page .yy-box .item .info .money {
  font-size: 28rpx;
}
