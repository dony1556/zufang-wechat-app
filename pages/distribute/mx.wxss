.page .top-box {
  padding: 40rpx 30rpx;
  background-color: #ff4544;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page .top-box .left .name {
  font-size: 28rpx;
  color: #fff;
}
.page .top-box .left .total {
  font-size: 32rpx;
  color: #fff;
  margin-top: 16rpx;
}
.page .top-box .right .txmx {
  width: 220rpx;
  line-height: 68rpx;
  text-align: center;
  height: 68rpx;
  border: 1rpx solid #fff;
  border-radius: 34rpx;
  color: #fff;
}
.page .item-box {
  background-color: #fff;
}
.page .item-box .item {
  padding: 36rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.page .item-box .item:not(:last-child) {
  border-bottom: 1rpx solid #f6f6f6;
}
.page .item-box .item .name {
  font-size: 28rpx;
}
.page .item-box .item .num {
  font-size: 28rpx;
  color: #f50;
}
.page .tx {
  margin: 30rpx 30rpx 20rpx;
  background-color: #f50;
  height: 76rpx;
  border-radius: 38rpx;
  color: #fff;
  line-height: 76rpx;
  text-align: center;
}
