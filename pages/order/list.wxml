<view class="page_box">
    <view class="head_box">
        <view class="order-nav x-f">
            <view bindtap="__e" class="nav-item y-f" data-event-opts="{{[ [ 'tap',[ [ 'onNav',['$0'],[ [ ['orderState','id',nav.id,'id'] ] ] ] ] ] ]}}" wx:for="{{orderState}}" wx:for-index="__i0__" wx:for-item="nav" wx:key="id">
                <view class="item-title">{{nav.title}}</view>
                <text class="{{['nav-line',status==nav.id?'line-active':'']}}"></text>
            </view>
        </view>
    </view>
    <view class="content_box">
        <view catchtap="__e" class="order-list" data-event-opts="{{[ [ 'tap',[ [ 'jump',[ '/pages/order/detail',[ 'o',['id',order.$orig.id] ] ] ] ] ] ]}}" wx:for="{{$root.l2}}" wx:for-index="__i1__" wx:for-item="order" wx:key="id">
            <view class="order-head x-bc">
                <text class="no">{{'订单编号：'+order.$orig.order_no}}</text>
