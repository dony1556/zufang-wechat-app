            </view>
            <view class="goods-order" wx:for="{{order.l1}}" wx:for-index="__i2__" wx:for-item="goods" wx:key="id">
                <view class="order-content"></view>
                <view class="goods-bottom  x-f">
                    <view class="btn-box" wx:for="{{goods.l0}}" wx:for-item="btn" wx:key="$orig">
                        <button catchtap="__e" class="{{['cu-btn','btn1',index+1===btn.g0?'btn2':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'jump',[ '/pages/goods/detail/index',[ 'o',['id',goods.$orig.goods_id] ] ] ] ] ] ]}}" wx:if="{{btn.$orig==='buy_again'}}">再次购买</button>
                        <button catchtap="__e" class="{{['cu-btn','btn1',index+1===btn.g1?'btn2':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'checkExpress',['$0','$1'],[ [ ['orderList','id',order.$orig.id,'id'] ],[ ['orderList','id',order.$orig.id],['order_goods','id',goods.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{btn.$orig==='express'}}">查看物流</button>
                        <button catchtap="__e" class="{{['cu-btn','btn1',index+1===btn.g2?'btn2':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'onConfirm',['$0','$1'],[ [ ['orderList','id',order.$orig.id,'id'] ],[ ['orderList','id',order.$orig.id],['order_goods','id',goods.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{btn.$orig==='get'}}">确认收货</button>
                        <button catchtap="__e" class="{{['cu-btn','btn1',index+1===btn.g3?'btn2':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'onAftersale',['$0','$1'],[ [ ['orderList','id',order.$orig.id,'id'] ],[ ['orderList','id',order.$orig.id],['order_goods','id',goods.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{btn.$orig==='aftersale'}}">申请售后</button>
                        <button catchtap="__e" class="{{['cu-btn','btn1',index+1===btn.g4?'btn2':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'onRefund',['$0','$1'],[ [ ['orderList','id',order.$orig.id,'id'] ],[ ['orderList','id',order.$orig.id],['order_goods','id',goods.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{btn.$orig==='reapply_refund'}}">重新退款</button>
                        <button catchtap="__e" class="{{['cu-btn','btn1',index+1===btn.g5?'btn2':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'onRefund',['$0','$1'],[ [ ['orderList','id',order.$orig.id,'id'] ],[ ['orderList','id',order.$orig.id],['order_goods','id',goods.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{btn.$orig==='apply_refund'}}">申请退款</button>
                        <button catchtap="__e" class="{{['cu-btn','btn1',index+1===btn.g6?'btn2':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'onComment',['$0','$1'],[ [ ['orderList','id',order.$orig.id,'id'] ],[ ['orderList','id',order.$orig.id],['order_goods','id',goods.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{btn.$orig==='comment'}}">待评价</button>
                        <button class="{{['cu-btn','btn1',index+1===btn.g7?'btn2':'']}}" wx:if="{{btn.$orig==='after_detail'}}">售后详情</button>
                    </view>
                </view>
            </view>
            <view class="order-num">
                <view class="num">{{'共'+order.$orig.total_num+'个商品,实付款'}}</view>
                <view class="fee">{{'¥'+order.$orig.total_fee+''}}</view>
            </view>
            <view class="order-bottom x-f" wx:if="{{order.g8}}">
                <view class="btn-box" wx:for="{{order.$orig.btns}}" wx:for-index="__i3__" wx:for-item="orderBtn" wx:key="*this">
                    <button catchtap="__e" class="cu-btn obtn1" data-event-opts="{{[ [ 'tap',[ [ 'onCancel',['$0'],[ [ ['orderList','id',order.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{orderBtn==='cancel'}}">取消订单22</button>
