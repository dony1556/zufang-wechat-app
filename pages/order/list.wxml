                    <button catchtap="__e" class="cu-btn obtn1" data-event-opts="{{[ [ 'tap',[ [ 'checkExpress',['$0'],[ [ ['orderList','id',order.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{orderBtn==='express'}}">查看物流</button>
                    <button catchtap="__e" class="cu-btn obtn2" data-event-opts="{{[ [ 'tap',[ [ 'onComment',['$0'],[ [ ['orderList','id',order.$orig.id,'id'] ] ] ] ] ] ]}}" wx:if="{{orderBtn==='comment'}}">评价</button>
                    <button catchtap="__e" class="cu-btn obtn2" data-event-opts="{{[ [ 'tap',[ [ 'jump',[ '/pages/activity/groupon/detail',[ 'o',['id',order.$orig.ext_arr.groupon_id] ] ] ] ] ] ]}}" wx:if="{{orderBtn==='groupon'}}">拼团详情</button>
                </view>
            </view>
        </view>
        <wk-empty bind:__l="__l" emptyData="{{emptyData}}" vueId="439118e4-1" wx:if="{{$root.g9}}"></wk-empty>
        <shopro-load bind:__l="__l" bind:input="__e" data-event-opts="{{[ [ '^input',[ [ '__set_model',[ '','isLoading','$event',[] ] ] ] ] ]}}" value="{{isLoading}}" vueId="439118e4-2"></shopro-load>
    </view>
    <view class="foot_box"></view>
    <shopro-tabbar bind:__l="__l" vueId="439118e4-3"></shopro-tabbar>
    <shopro-float-btn bind:__l="__l" vueId="439118e4-4"></shopro-float-btn>
    <shopro-login-modal bind:__l="__l" vueId="439118e4-5"></shopro-login-modal>
</view>
