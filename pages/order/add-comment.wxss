.goods-card {
  margin: 10rpx 0;
  padding: 20rpx;
  background: #fff;
}
.goods-card .price-box {
  font-size: 26rpx;
  width: 510rpx;
  color: #999;
}
.goods-card .price-box .goods-price {
  color: #333;
}
.form-item {
  background: #fff;
  padding-bottom: 30rpx;
}
.form-item .star-box {
  height: 100rpx;
  padding: 0 25rpx;
}
.area-box {
  width: 690rpx;
  min-height: 306rpx;
  background: #f9fafb;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: auto;
}
.area-box .pl-style {
  font-size: 26rpx;
  font-family: PingFang SC;
  font-weight: 400;
  color: #999;
  line-height: 42rpx;
}
.area-box .inp-area {
  font-size: 26rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333;
  line-height: 50rpx;
  width: 100%;
}
.area-box .img-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.area-box .img-box .choose-img,
.area-box .img-box .preview-box {
  width: 108rpx;
  height: 108rpx;
  background: #f9fafb;
  border: 1rpx solid #dfdfdf;
  margin-right: 25rpx;
  margin-bottom: 25rpx;
  position: relative;
}
.area-box .img-box .choose-img:nth-child(5n),
.area-box .img-box .preview-box:nth-child(5n) {
  margin-right: 0;
}
.area-box .img-box .choose-img .cuIcon-cameraadd,
.area-box .img-box .preview-box .cuIcon-cameraadd {
  font-size: 50rpx;
  color: #dfdfdf;
}
.area-box .img-box .choose-img .preview-img,
.area-box .img-box .preview-box .preview-img {
  width: 100%;
  height: 100%;
}
.area-box .img-box .choose-img .cuIcon-close,
.area-box .img-box .preview-box .cuIcon-close {
  background: linear-gradient(90deg, #d89f64, #ebc196);
  border-radius: 50%;
  width: 40rpx;
  line-height: 40rpx;
  color: #fff;
  text-align: center;
  position: absolute;
  top: -10rpx;
  right: -10rpx;
}
.post-btn {
  width: 690rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #f0c785, #f6d69d);
  border-radius: 40rpx;
  color: hsla(0, 0%, 100%, 0.9);
  margin-bottom: 30rpx;
}
