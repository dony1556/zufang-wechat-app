.goods-box {
  background: #fff;
  padding: 30rpx 25rpx;
  margin-bottom: 20rpx;
}
.goods-item {
  height: 95rpx;
  background: #fff;
  padding: 0 25rpx;
  margin-bottom: 20rpx;
  border-top: 1rpx solid hsla(0, 0%, 87.5%, 0.5);
}
.goods-item:nth-of-type(2n) {
  margin-bottom: 0;
  border-top: 0;
}
.goods-item .item-title {
  font-size: 28rpx;
}
.goods-item .cuIcon-right {
  font-size: 32rpx;
}
.goods-item .price {
  font-size: 28rpx;
  color: #a8700d;
}
.upload-img {
  background: #fff;
  padding: 30rpx 25rpx;
}
.upload-img .upload-title {
  font-size: 28rpx;
}
.img-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.img-box .choose-img,
.img-box .preview-box {
  width: 120rpx;
  height: 120rpx;
  background: #f9fafb;
  border: 1rpx solid #dfdfdf;
  margin-right: 25rpx;
  margin-bottom: 25rpx;
  position: relative;
}
.img-box .choose-img:nth-child(5n),
.img-box .preview-box:nth-child(5n) {
  margin-right: 0;
}
.img-box .choose-img .cuIcon-cameraadd,
.img-box .preview-box .cuIcon-cameraadd {
  font-size: 50rpx;
  color: #dfdfdf;
}
.img-box .choose-img .preview-img,
.img-box .preview-box .preview-img {
  width: 100%;
  height: 100%;
}
.img-box .choose-img .cuIcon-close,
.img-box .preview-box .cuIcon-close {
  background: linear-gradient(90deg, #d89f64, #ebc196);
  border-radius: 50%;
  width: 40rpx;
  line-height: 40rpx;
  color: #fff;
  text-align: center;
  position: absolute;
  top: -10rpx;
  right: -10rpx;
}
.foot_box .sub-btn {
  width: 710rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #e9b461, #eecc89);
  border: 1rpx solid #eee;
  border-radius: 40rpx;
  color: hsla(0, 0%, 100%, 0.9);
  margin-bottom: 30rpx;
}
.modal-box {
  width: 750rpx;
  height: 680rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #fff;
}
.modal-box .modal-head {
  height: 100rpx;
  font-size: 30rpx;
}
.modal-box .modal-content {
  font-size: 28rpx;
}
.modal-box .modal-content .sel-item {
  height: 100rpx;
  width: 100%;
  padding: 0 20rpx;
  border-bottom: 1rpx solid hsla(0, 0%, 87.5%, 0.5);
}
.modal-box .modal-content .sel-item .sel-radio {
  transform: scale(0.7);
}
.modal-box .modal-foot .close-btn {
  width: 710rpx;
  height: 80rpx;
  background: linear-gradient(90deg, #e9b461, #eecc89);
  border: 1rpx solid #eee;
  border-radius: 40rpx;
  color: hsla(0, 0%, 100%, 0.9);
}
