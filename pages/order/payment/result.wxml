<view class="success-page">
    <view class="success-box flex flex-direction align-center" wx:if="{{orderDetail.total_fee}}">
        <image mode class="pay-img" src="{{pay?'http://shopro.7wpp.com/imgs/pay_success.png':'http://shopro.7wpp.com/imgs/pay_fail.png'}}"></image>
        <text class="notice">{{pay?'支付成功':'支付失败'}}</text>
        <text class="pay-money" wx:if="{{pay&&orderDetail.total_fee}}">{{'￥'+orderDetail.total_fee}}</text>
        <view class="btn-box flex justify-between">
            <block wx:if="{{pay&&orderDetail.activity_type==='groupon'&&orderDetail.ext_arr.buy_type==='groupon'}}">
                <button bindtap="__e" class="cu-btn base-btn" data-event-opts="{{[ [ 'tap',[ [ 'replace',[ '/pages/activity/groupon/detail',[ 'o',['id',orderDetail.ext_arr.groupon_id] ] ] ] ] ] ]}}" wx:if="{{orderDetail.ext_arr.groupon_id>0}}">拼团详情</button>
                <button bindtap="__e" class="cu-btn base-btn" data-event-opts="{{[ [ 'tap',[ [ 'replace',['/pages/activity/groupon/my-groupon'] ] ] ] ]}}" wx:else>我的拼团</button>
            </block>
            <button bindtap="__e" class="cu-btn base-btn" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" wx:else>返回首页</button>
            <button bindtap="__e" class="cu-btn base-btn" data-event-opts="{{[ [ 'tap',[ [ 'onOrder',['$event'] ] ] ] ]}}">查看订单</button>
            <button bindtap="__e" class="again-pay cu-btn" data-event-opts="{{[ [ 'tap',[ [ 'onPay',['$event'] ] ] ] ]}}" wx:if="{{!pay}}">重新支付</button>
        </view>
    </view>
    <shopro-login-modal bind:__l="__l" vueId="9264f934-1"></shopro-login-modal>
</view>
