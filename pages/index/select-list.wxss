.page {
  background-color: #fff;
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.page .top-box {
  background-color: #fff;
}
.page .top-box .search-box {
  background-color: #f7f8f9;
  margin: 16rpx 40rpx 0rpx 40rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}
.page .top-box .search-box .icon {
  font-size: 36rpx;
  color: #a2a2a2;
}
.page .top-box .search-box .text {
  margin-left: 20rpx;
  flex: 1;
}
.page .content-box {
  flex: 1;
  overflow-y: auto;
}
