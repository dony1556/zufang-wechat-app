.img-w {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 20rpx;
}
.img-w .left {
  width: 340rpx;
  height: 340rpx;
}
.img-w .left .item {
  position: relative;
}
.img-w .left .item .img {
  width: 100%;
  height: 340rpx;
  border-radius: 6rpx;
  display: block;
}
.img-w .right {
  width: 340rpx;
}
.img-w .right .item2 {
  position: relative;
}
.img-w .right .item2 .img {
  width: 100%;
  height: 160rpx;
  border-radius: 6rpx;
  display: block;
}
.img-w .right .item3 {
  margin-top: 20rpx;
  position: relative;
}
.img-w .right .item3 .img {
  width: 100%;
  height: 160rpx;
  border-radius: 6rpx;
  display: block;
}
