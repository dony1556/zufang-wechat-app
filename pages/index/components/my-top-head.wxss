.top-box {
  position: relative;
  width: 100%;
  height: 480rpx;
}
.top-box .top-img {
  width: 100%;
  height: 480rpx;
}
.top-box .user {
  width: 100%;
  height: 160rpx;
  display: flex;
  align-items: center;
  position: absolute;
  top: 100rpx;
}
.top-box .user .img-box {
  width: 90rpx;
  height: 90rpx;
  margin-left: 40rpx;
  margin-right: 30rpx;
  position: relative;
}
.top-box .user .img-box .avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  overflow: hidden;
}
.top-box .user .img-box .fresh {
  position: absolute;
  right: 0rpx;
  top: 0rpx;
  font-size: 30rpx;
  color: #fff;
}
.top-box .user .right .text {
  color: #666;
  font-size: 30rpx;
  font-weight: 700;
}
.top-box .user .right .phone {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}
.top-box .user .right .phone .btn1 {
  margin-left: 4rpx;
  background: transparent;
  color: #666;
  font-size: 26rpx;
  line-height: normal;
  padding: 0;
}
.top-box .user .right .login {
  color: #666;
  font-size: 28rpx;
  font-weight: 700;
}
.top-box .user .right .welcome {
  font-size: 25rpx;
  margin-top: 10rpx;
  min-height: 20rpx;
}
.top-box .buyvip {
  position: relative;
  width: 700rpx;
  font-size: 24rpx;
  padding: 17rpx 25rpx;
  background: linear-gradient(90deg, #eabf8c, #fdd2a5);
  color: #62430e;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-radius: 10rpx;
  z-index: 5;
  position: absolute;
  top: 250rpx;
  left: 25rpx;
}
.top-box .buyvip .vipleft {
  display: flex;
  align-items: center;
}
.top-box .buyvip .vipleft image {
  width: 45rpx;
  height: 45rpx;
  margin-right: 5rpx;
}
.top-box .buyvip .vipright {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}
