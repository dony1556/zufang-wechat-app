.nav-box {
  background-color: #fff;
  padding: 16rpx 0rpx;
  box-shadow: 0 0 40rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}
.nav-box .item {
  height: 100rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 0rpx 20rpx;
  position: relative;
}
.nav-box .item:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}
.nav-box .item .content {
  flex: 1;
  width: 0;
  margin-left: 16rpx;
  display: flex;
  align-items: flex-end;
}
.nav-box .item .content .text {
  font-size: 26rpx;
  color: #757575;
  margin-right: 30rpx;
}
.nav-box .item .content .des {
  font-size: 24rpx;
  color: #757575;
}
.nav-box .item .img-box {
  width: 40rpx;
  height: 40rpx;
}
.nav-box .item .img-box .img {
  width: 100%;
  height: 100%;
}
