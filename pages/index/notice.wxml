<view class="page">
    <view class="item">
        <view class="left">
            <view class="name">预约看房</view>
            <view class="num">剩余通知次数：<text style="font-size:32rpx;font-weight:bold;">{{user.notice_yy_num}}</text>
            </view>
        </view>
        <view bindtap="__e" class="right" data-event-opts="{{[ [ 'tap',[ ['yy_add'] ] ] ]}}">点击添加</view>
    </view>
    <view class="item">
        <view class="left">
            <view class="name">未读消息提醒</view>
            <view class="num">剩余通知次数：<text style="font-size:32rpx;font-weight:bold;">{{user.notice_news_num}}</text>
            </view>
        </view>
        <view bindtap="__e" class="right" data-event-opts="{{[ [ 'tap',[ ['handler_new_add'] ] ] ]}}">点击添加</view>
    </view>
    <view class="item">
        <view class="left">
            <view class="name">房源发布</view>
            <view class="num">剩余通知次数：<text style="font-size:32rpx;font-weight:bold;">{{user.notice_hp_num}}</text>
            </view>
        </view>
        <view bindtap="__e" class="right" data-event-opts="{{[ [ 'tap',[ ['hp_add'] ] ] ]}}">点击添加</view>
    </view>
    <view class="item">
        <view class="left">
            <view class="name">审核通知</view>
            <view class="num">剩余通知次数：<text style="font-size:32rpx;font-weight:bold;">{{user.notice_check_num}}</text>
            </view>
        </view>
        <view bindtap="__e" class="right" data-event-opts="{{[ [ 'tap',[ ['check_add'] ] ] ]}}">点击添加</view>
    </view>
</view>
