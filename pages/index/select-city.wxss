.page .top-box {
  background-color: #fff;
}
.page .search-box {
  background-color: #f7f8f9;
  padding: 16rpx 30rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
}
.page .search-box .search {
  flex: 1;
  border-radius: 36rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  padding: 0rpx 30rpx;
  background-color: #fff;
}
.page .search-box .search .input {
  flex: 1;
  width: 0;
  margin-left: 16rpx;
  outline-style: none;
  height: 70rpx;
  font-size: 24rpx;
}
.page .content-box {
  width: 100%;
  padding: 20rpx 20rpx;
  height: calc(100vh - 100rpx);
}
.page .content-box .location-box {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  width: 100%;
  padding-bottom: 30rpx;
}
.page .content-box .location-box .tit {
  font-size: 26rpx;
  font-weight: 700;
  width: 100%;
  margin: 20rpx 0rpx;
}
.page .content-box .location-box .location {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.page .content-box .location-box .location .b {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  background-color: #fff;
}
.page .content-box .location-box .location .b .text {
  font-size: 24rpx;
  line-height: 40rpx;
}
.page .content-box .location-box .location .tip {
  font-size: 22rpx;
  color: #999;
  margin-left: 20rpx;
}
.page .content-box .location-box .location .fresh {
  font-size: 32rpx;
  color: #f50;
  position: absolute;
  right: 50rpx;
}
.page .content-box .title {
  font-size: 26rpx;
  font-weight: 700;
  width: 100%;
  margin: 20rpx 0rpx;
}
.page .content-box .citys {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}
.page .content-box .citys .item {
  width: 33.333%;
  flex-shrink: 0;
  display: flex;
  justify-content: center;
  margin-top: 26rpx;
}
.page .content-box .citys .item .text {
  width: 90%;
  background-color: #fff;
  font-size: 26rpx;
  text-align: center;
  line-height: 70rpx;
}
.page .content-box .s-item {
  padding: 16rpx 16rpx;
}
.page .content-box .s-item .f {
  font-style: 26rpx;
  line-height: 80rpx;
  font-weight: 700;
}
.page .content-box .s-item .c .item2 {
  font-size: 26rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #ececec;
}
.page .fix-box {
  position: fixed;
  right: 30rpx;
  top: 80rpx;
}
.page .fix-box .item {
  font-size: 24rpx;
  margin-top: 22rpx;
  width: 36rpx;
  height: 36rpx;
  text-align: center;
  line-height: 36rpx;
}
.page .fix-box .item.active {
  background-color: #000;
  color: #fff;
  border-radius: 50%;
}
