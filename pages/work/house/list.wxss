.page .top-box {
  width: 100%;
  border-bottom: 1rpx solid #f7f8f9;
  position: -webkit-sticky;
  position: sticky;
  top: 0rpx;
  background-color: #fff;
  padding: 0rpx 16rpx;
  z-index: 999999;
}
.page .top-box .search-box {
  display: flex;
  justify-content: center;
  padding: 16rpx 0rpx;
}
.page .top-box .search-box .item {
  width: 650rpx;
  border-radius: 34rpx;
  height: 68rpx;
  padding-left: 30rpx;
  border: 1rpx solid #efefef;
  overflow: hidden;
  display: flex;
}
.page .top-box .search-box .item .input {
  flex: 1;
  height: 68rpx;
  font-size: 26rpx;
}
.page .top-box .search-box .item .search {
  width: 140rpx;
  height: 68rpx;
  background-color: #ffaa7f;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #fff;
}
.page .top-box .scroll {
  height: 90rpx;
  white-space: nowrap;
  width: 100%;
  text-align: center;
}
.page .top-box .scroll .item {
  height: 90rpx;
  padding: 0 30rpx;
  display: inline-block;
}
.page .top-box .scroll .item .name {
  height: 74rpx;
  line-height: 74rpx;
  font-size: 26rpx;
}
.page .top-box .scroll .item .line {
  margin-left: 20%;
  width: 60%;
  height: 4rpx;
  background-color: #f50;
  border-radius: 6rpx;
}
.page .house-box .item {
  margin: 20rpx 20rpx;
  padding: 12rpx 10rpx;
  background-color: #fff;
  border-radius: 10rpx;
}
.page .house-box .item .top {
  display: flex;
  align-items: center;
  height: 60rpx;
}
.page .house-box .item .top .title {
  flex: 1;
  width: 0rpx;
  font-size: 28rpx;
}
.page .house-box .item .top .status {
  margin: 0rpx 12rpx;
  color: red;
  font-size: 24rpx;
}
.page .house-box .item .bot {
  margin-top: 16rpx;
}
.page .house-box .item .bot .tip {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #c5c5c5;
}
.page .house-box .item .bot .top-msg {
  font-size: 26rpx;
  color: #e7b72f;
  margin-top: 20rpx;
}
.page .house-box .item .bot .button-box {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  background-color: #f8f8f8;
  padding: 20rpx 20rpx;
}
.page .house-box .item .bot .button-box .bt {
  width: 40%;
  margin: 20rpx 5%;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  text-align: center;
  color: #fff;
}
