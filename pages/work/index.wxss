.page {
  background-color: #fff;
  padding-top: 20rpx;
}
.page .no-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
}
.page .no-box .img {
  width: 420rpx;
  height: 240rpx;
}
.page .no-box .tip {
  font-size: 30rpx;
  margin-top: 80rpx;
}
.page .no-box .apply {
  height: 80rpx;
  width: 560rpx;
  border-radius: 40rpx;
  margin: 88rpx auto 40rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 80rpx;
  background: #ff4544;
  text-align: center;
}
.page .wait-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
}
.page .wait-box .img {
  width: 420rpx;
  height: 240rpx;
}
.page .wait-box .tip {
  font-size: 30rpx;
  margin-top: 80rpx;
}
.page .wait-box .apply {
  height: 80rpx;
  width: 560rpx;
  border-radius: 40rpx;
  margin: 88rpx auto 40rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 80rpx;
  background: #ff4544;
  text-align: center;
}
.page .delete-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 200rpx;
}
.page .delete-box .img {
  width: 420rpx;
  height: 240rpx;
}
.page .delete-box .tip {
  font-size: 30rpx;
  margin-top: 80rpx;
}
.page .delete-box .tip2 {
  font-size: 26rpx;
  margin-top: 20rpx;
  padding: 0rpx 20rpx;
}
.page .delete-box .apply {
  height: 80rpx;
  width: 560rpx;
  border-radius: 40rpx;
  margin: 88rpx auto 40rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 80rpx;
  background: #ff4544;
  text-align: center;
}
.page .head-box {
  display: flex;
  padding: 60rpx 50rpx;
  background: linear-gradient(45deg, #f50, #ff557f);
  margin: 20rpx 20rpx;
  border-radius: 16rpx;
}
.page .head-box .img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 1rpx solid #fff;
}
.page .head-box .info {
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.page .head-box .info .name {
  color: #fff;
  font-size: 26rpx;
}
.page .head-box .info .tel {
  color: #fff;
  margin-top: 16rpx;
  font-size: 26rpx;
}
.page .item-box {
  width: 700rpx;
  margin: 45rpx 25rpx 30rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.page .item-box .item {
  width: 48%;
  height: 150rpx;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
}
.page .item-box .item .img-box {
  width: 40%;
  display: flex;
  justify-content: center;
  align-items: center;
}
.page .item-box .item .img-box .img {
  width: 80rpx;
  height: 80rpx;
}
.page .item-box .item .text-box {
  width: 100%;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: #fff;
}
.page .item-box .item .text-box .title {
  font-weight: 700;
  text-align: center;
}
.page .item-box .item .text-box .text {
  font-size: 24rpx;
  text-align: center;
  margin-top: 16rpx;
}
