.shop-list {
  width: 345rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
}
.shop-list .image-box {
  margin-bottom: 20rpx;
  width: 345rpx;
  height: 345rpx;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
}
.shop-list .image-box .shop-img {
  width: 100%;
  height: 100%;
  background: #ccc;
}
.shop-list .shop-title {
  font-size: 28rpx;
  line-height: 36rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #333;
  line-height: 36rpx;
  width: 300rpx;
  margin: 0 auto 20rpx;
  height: 72rpx;
}
.shop-list .num-box {
  width: 100%;
  padding: 0 12rpx;
  flex-wrap: wrap;
}
.shop-list .beans-box {
  font-size: 32rpx;
  font-family: SimHei;
  font-weight: 700;
  color: #e48d04;
  margin-bottom: 10rpx;
}
.shop-list .beans-box .bean-img {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}
.shop-list .end-cash {
  font-size: 22rpx;
  font-family: PingFang SC;
  font-weight: 500;
  color: #999;
  margin-bottom: 10rpx;
}
