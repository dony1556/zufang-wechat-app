page {
  background: #fff;
}
.goods-box {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx;
  background-color: #fff;
}
.goods-box .goods-list {
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 0 20rpx 4rpx hsla(0, 0%, 78%, 0.22);
  border-radius: 20rpx;
  overflow: hidden;
}
.goods-box .goods-list:nth-child(2n) {
  margin-right: 0;
}
