<view class="page">
    <view class="top">
        <view class="gfzg-remark" wx:if="{{$root.g0==0}}">{{pc.remark}}</view>
        <view bindtap="__e" class="last" data-event-opts="{{[ [ 'tap',[ ['back'] ] ] ]}}" wx:if="{{last_title&&!result}}">
            <text space="emsp">{{last_title}}</text>
        </view>
        <view class="choose-box" wx:if="{{result}}">
            <view class="item" wx:for="{{item_list}}" wx:for-index="index3" wx:for-item="item3" wx:key="index3">
                <text>{{item3.title}}</text>
                <text style="color:#ff4544;margin-left:16rpx;">{{item3.children[item3.choose_index].title}}</text>
            </view>
        </view>
    </view>
    <view class="content">
        <block wx:if="{{result}}">
            <view class="result">{{result}}</view>
            <view class="btn-box">
                <view bindtap="__e" class="btn" data-event-opts="{{[ [ 'tap',[ [ 'again',['$event'] ] ] ] ]}}">再测一次</view>
                <view class="btn2">转发分享<button class="system-buttom" openType="share"></button>
                </view>
            </view>
        </block>
        <block wx:else>
            <view class="title">{{item.title}}</view>
            <view class="item-box">
                <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'choose_item2',[index2] ] ] ] ]}}" wx:for="{{item.children}}" wx:for-index="index2" wx:for-item="item2" wx:key="index2">
                    <view class="title2">{{item2.title}}</view>
                    <view class="iconfont icon-gouxuan" style="font-size:28rpx;color:#00aaff;" wx:if="{{choose_index==index2}}"></view>
                    <view class="iconfont icon-gouxuan1" style="font-size:28rpx;color:#999;" wx:if="{{choose_index!=index2}}"></view>
                </view>
            </view>
            <view class="remark">{{item.remark}}</view>
        </block>
    </view>
</view>
