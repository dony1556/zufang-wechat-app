page {
  background-color: #fff;
}
page .float-box {
  position: fixed;
  bottom: 260rpx;
  right: 50rpx;
  z-index: 9999;
}
page .float-box .pub {
  font-size: 46rpx;
  border-radius: 50%;
  background-color: #fff;
  color: #01aaed;
  width: 90rpx;
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 6rpx 6rpx 6rpx #535353;
  margin-top: 30rpx;
}
page .float-box .my {
  font-size: 24rpx;
  border-radius: 50%;
  background-color: #fff;
  color: #01aaed;
  width: 90rpx;
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 6rpx 6rpx 6rpx #535353;
}
page .swiper-box {
  height: 400rpx;
}
page .swiper-box .slide-swiper {
  width: 100%;
  height: 400rpx;
  position: relative;
  background-color: #fff;
  margin-top: 12rpx;
}
page .swiper-box .slide-swiper .swiper-item {
  width: 100%;
  font-size: 0;
  line-height: 0;
}
page .swiper-box .slide-swiper .swiper-item .item {
  width: 100%;
  height: 100%;
  padding: 0 20rpx;
}
page .swiper-box .slide-swiper .swiper-item .item .img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
page page {
  background-color: #fff;
}
page .head {
  height: 400rpx;
  margin-bottom: 60rpx;
  position: relative;
}
page .head .ab {
  position: absolute;
  bottom: -60rpx;
  right: 28rpx;
  display: flex;
}
page .head .ab .my_name {
  font-size: 38rpx;
  color: #fff;
  padding-top: 15rpx;
  padding-right: 29rpx;
}
page .head .ab .my_img {
  overflow: hidden;
  border: 5rpx solid #fff;
  border-radius: 10%;
  width: 135rpx;
  height: 135rpx;
}
page .item-box .item {
  display: flex;
  margin-top: 15rpx;
  padding: 15rpx 10rpx;
}
page .item-box .item .user_img {
  width: 80rpx;
  overflow: hidden;
  margin-right: 20rpx;
  display: flex;
  justify-content: center;
}
page .item-box .item .user_img image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
}
page .item-box .item .right {
  display: flex;
  flex-direction: column;
  flex: 1;
  width: 0;
}
page .item-box .item .right .head-box {
  display: flex;
  justify-content: space-between;
}
page .item-box .item .right .head-box .name {
  font-weight: 700;
  color: #0643b4;
  font-size: 30rpx;
}
page .item-box .item .right .head-box .type {
  font-size: 24rpx;
  margin-right: 36rpx;
}
page .item-box .item .right .describe {
  font-size: 26rpx;
  margin: 10rpx 0;
}
page .item-box .item .right .describe .txt {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
}
page .item-box .item .right .img-box {
  display: flex;
  flex-wrap: wrap;
}
page .item-box .item .right .img-box .item {
  width: 33.3%;
  height: 192rpx;
  padding-right: 8rpx;
  margin-bottom: 8rpx;
  font-size: 0;
  overflow: hidden;
}
page .item-box .item .right .img-box .item .img {
  width: 100%;
  border-radius: 6rpx;
}
page .item-box .item .right .bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  align-content: center;
  height: 80rpx;
}
page .item-box .item .right .bot .time {
  font-size: 22rpx;
  color: #999;
}
page .item-box .item .right .bot .mark {
  display: flex;
  align-items: center;
}
page .item-box .item .right .bot .mark .zt {
  width: 320rpx;
  margin-right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  overflow: hidden;
  opacity: 0;
}
page .item-box .item .right .bot .mark .pl {
  display: flex;
  justify-content: space-around;
  align-items: center;
  width: 280rpx;
  height: 80rpx;
  background-color: #353535;
  border-radius: 10rpx;
}
page .item-box .item .right .bot .mark .pl .iconfont {
  display: flex;
  align-items: center;
}
page .item-box .item .right .bot .mark .pl text {
  font-size: 26rpx;
  margin-left: 5rpx;
}
page .item-box .item .right .bot .mark .sanjiao {
  width: 0;
  height: 0;
  border-width: 15rpx 0 15rpx 15rpx;
  border-style: solid;
  border-color: transparent transparent transparent #353535;
  position: relative;
}
page .item-box .item .right .bot .mark .more {
  display: flex;
  background-color: #e6dfdf;
  border-radius: 8rpx;
  padding: 0 10rpx;
}
page .item-box .item .right .p {
  background-color: #e6dfdf;
  border-radius: 10rpx;
  padding: 4rpx 15rpx;
}
page .item-box .item .right .p .zans {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #fff;
}
page .item-box .item .right .p .zans .zan {
  color: #0643b4;
  font-size: 26rpx;
  margin-right: 8rpx;
  margin-bottom: 4rpx;
}
page .item-box .item .right .p .pls {
  display: flex;
  flex-direction: column;
}
page .item-box .item .right .p .pls .pl {
  padding: 4rpx 1rpx;
}
page .item-box .item .right .p .pls .pl .name {
  margin-right: 10rpx;
  color: #0643b4;
  font-size: 26rpx;
}
page .item-box .item .right .p .pls .pl .comment {
  font-size: 24rpx;
}
page .hidden {
  opacity: 0 !important;
  animation: bounceOutLeft 10s 1 ease;
}
page .carousel {
  width: 100%;
}
@-webkit-keyframes bounceInLeft {
  0% {
    opacity: 0;
    transform: translate3d(250rpx, 0, 0);
  }
  60% {
    transform: translate3d(-50rpx, 0, 0);
  }
  75% {
    transform: translate3d(50rpx, 0, 0);
  }
  90% {
    opacity: 1;
    transform: translate3d(-10rpx, 0, 0);
  }
  100% {
    transform: none;
  }
}
@keyframes bounceInLeft {
  0% {
    opacity: 0;
    transform: translate3d(250rpx, 0, 0);
  }
  60% {
    transform: translate3d(-50rpx, 0, 0);
  }
  75% {
    transform: translate3d(50rpx, 0, 0);
  }
  90% {
    opacity: 1;
    transform: translate3d(-10rpx, 0, 0);
  }
  100% {
    transform: none;
  }
}
.show {
  opacity: 1 !important;
  animation: bounceInLeft 1s 1 cubic-bezier(0.215, 0.61, 0.355, 1);
}
@-webkit-keyframes bounceOutLeft {
  0% {
    opacity: 1;
    transform: translate3d(-50rpx, 0, 0);
  }
  20% {
    opacity: 1;
    transform: translate3d(50rpx, 0, 0);
  }
  40% {
    opacity: 0.5;
    transform: translate3d(-150rpx, 0, 0);
  }
  100% {
    opacity: 0;
    transform: translate3d(250rpx, 0, 0);
  }
}
@keyframes bounceOutLeft {
  0% {
    opacity: 1;
    transform: translate3d(-50rpx, 0, 0);
  }
  20% {
    opacity: 1;
    transform: translate3d(50rpx, 0, 0);
  }
  40% {
    opacity: 0.5;
    transform: translate3d(-150rpx, 0, 0);
  }
  100% {
    opacity: 0;
    transform: translate3d(250rpx, 0, 0);
  }
}
