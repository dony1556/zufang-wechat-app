<view class="container">
    <view class="x-c">
        <image mode class="logo-bg" src="http://shopro.7wpp.com/imgs/logo_bg.png"></image>
    </view>
    <view class="head-box">
        <cu-custom bind:__l="__l" isBack="{{true}}" vueId="41ebb566-1"></cu-custom>
    </view>
    <view class="wrapper">
        <view class="x-c">
            <image class="logo" mode="widthFix" src="{{sysInfo.logo}}"></image>
        </view>
        <view class="login-box y-f">
            <view class="input-item x-c">
                <text class="inp-title">手机号</text>
                <input bindinput="__e" class="inp" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '','mobile','$event',[] ] ] ] ] ]}}" placeholder="请输入手机号" placeholderClass="pl" type="number" value="{{mobile}}"></input>
            </view>
            <view class="input-item x-c">
                <text class="inp-title">验证码</text>
                <input bindinput="__e" class="inp" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','value','$event',[] ],['code'] ] ] ] ]}}" placeholder="请输入验证码" placeholderClass="pl" type="number" value="{{code.value}}"></input>
                <button bindtap="__e" class="cu-btn code-btn" data-event-opts="{{[ [ 'tap',[ [ 'getCode',['$event'] ] ] ] ]}}" disabled="{{code.status}}">{{code.text}}</button>
            </view>
            <view class="input-item x-c">
                <text class="inp-title">密 码</text>
                <input bindinput="__e" class="inp" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '','password','$event',[] ] ] ] ] ]}}" password="{{true}}" placeholder="请输入6-14位密码" placeholderClass="pl" type="text" value="{{password}}"></input>
            </view>
            <view bindtap="__e" class="tip-box" data-event-opts="{{[ [ 'tap',[ [ 'onTcp',['$event'] ] ] ] ]}}">
                <label class="x-f">
                    <radio checked="{{isTcp}}" class="{{['tcp-radio','brown',isTcp?'checked':'']}}"></radio>
                    <view>我已阅读并遵守<text bindtap="__e" class="tcp" data-event-opts="{{[ [ 'tap',[ [ 'jump',[ '/pages/public/richtext',[ 'o',['id',1] ] ] ] ] ] ]}}">《用户协议》</text>与<text bindtap="__e" class="tcp" data-event-opts="{{[ [ 'tap',[ [ 'jump',[ '/pages/public/richtext',[ 'o',['id',2] ] ] ] ] ] ]}}">《隐私协议》</text>
                    </view>
                </label>
            </view>
        </view>
        <view class="x-c y-f">
            <button bindtap="__e" class="cu-btn login-btn" data-event-opts="{{[ [ 'tap',[ [ 'register',['$event'] ] ] ] ]}}">立即注册</button>
        </view>
    </view>
</view>
