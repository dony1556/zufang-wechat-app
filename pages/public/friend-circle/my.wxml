<view class="page">
    <view class="item-box">
        <view class="item" wx:for="{{$root.l0}}" wx:key="index">
            <view class="user_img">
                <image src="{{item.$orig.avatarurl}}"></image>
            </view>
            <view class="right">
                <view class="head-box">
                    <view class="name">{{item.$orig.nickname}}</view>
                    <view catchtap="__e" class="iconfont icon-shanchu del" data-event-opts="{{[ [ 'tap',[ [ 'del',['$0'],[ [ ['list','',index,'id'] ] ] ] ] ] ]}}"></view>
                </view>
                <view class="describe">
                    <text>{{item.$orig.title}}</text>
                </view>
                <view class="img-box">
                    <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" data-event-params="{{({item:item.$orig,index2:index2})}}" wx:for="{{item.$orig.imgs}}" wx:for-index="index2" wx:for-item="item2" wx:key="index2">
                        <image class="img" mode="widthFix" src="{{item2}}"></image>
                    </view>
                </view>
                <view class="bot">
                    <view class="time">{{item.$orig.create_time}}</view>
                </view>
                <view class="p" wx:if="{{item.g0}}">
                    <view class="zans">
                        <text class="iconfont icon-xin" style="font-size:32rpx;color:#0643b4;margin-right:8rpx;"></text>
                    </view>
                    <view class="pls">
                        <view wx:for="{{item.$orig.pls}}" wx:for-index="index3" wx:for-item="item3" wx:key="index3">
                            <text class="name">{{item3.name+'：'}}</text>
                            <text class="comment">{{item3.comment}}</text>
                        </view>
                    </view>
                </view>
                <view class="status-box">
                    <view class="status" wx:if="{{item.$orig.status==0}}">待审核</view>
                    <view class="msg" wx:if="{{item.$orig.status==4}}">{{'驳回：'+item.$orig.check_msg+''}}</view>
                </view>
            </view>
        </view>
    </view>
    <wk-empty bind:__l="__l" emptyData="{{emptyData}}" vueId="78813466-1" wx:if="{{$root.g1==0}}"></wk-empty>
    <wk-skeletons bind:__l="__l" type="detail" vueId="78813466-2" wx:if="{{isLoading}}"></wk-skeletons>
</view>
