<view class="page">
    <view class="top-box"></view>
    <view class="form">
        <view class="form-item">
            <view class="title">标题</view>
            <view class="right">
                <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','title','$event',[] ],['form'] ] ] ] ]}}" placeholder="请填写标题" value="{{form.title}}"></input>
            </view>
        </view>
        <view class="form-item">
            <text class="title">图片</text>
            <view class="right">
                <view class="img-box">
                    <view class="preview-box" wx:for="{{form.imgs}}" wx:key="index">
                        <image class="preview-img" mode="aspectFill" src="{{item}}"></image>
                        <text bindtap="__e" class="cuIcon-close" data-event-opts="{{[ [ 'tap',[ [ 'delImg',['$0',index],['form.imgs'] ] ] ] ]}}"></text>
                    </view>
                    <view bindtap="__e" class="choose-img " data-event-opts="{{[ [ 'tap',[ [ 'onChooseImg',['$0',9],['form.imgs'] ] ] ] ]}}" wx:if="{{$root.g0<9}}">
                        <text class="cuIcon-cameraadd"></text>
                    </view>
                </view>
            </view>
        </view>
        <view class="btn-box">
            <form bindsubmit="__e" data-event-opts="{{[ [ 'submit',[ [ 'formSubmit',['$event'] ] ] ] ]}}">
                <button class="submit" formType="submit" type="primary">提交</button>
            </form>
        </view>
    </view>
</view>
