<view class="page">
    <view class="float-box">
        <view bindtap="__e" class="my" data-event-opts="{{[ [ 'tap',[ [ 'navtoMy',['$event'] ] ] ] ]}}">我的</view>
        <view bindtap="__e" class="pub" data-event-opts="{{[ [ 'tap',[ [ 'pub',['$event'] ] ] ] ]}}" wx:if="{{set.add_on==1}}">+</view>
    </view>
    <view class="swiper-box">
        <swiper autoplay="true" class="slide-swiper">
            <swiper-item class="swiper-item" wx:for="{{swiperList}}" wx:key="index">
                <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'navto',['$event'] ] ] ] ]}}">
                    <image class="img" mode="aspectFill" src="{{item.img}}"></image>
                </view>
            </swiper-item>
        </swiper>
    </view>
    <view class="item-box">
        <view class="{{['item',toggleDelay?'animation-slide-bottom':'']}}" style="{{'animation-delay:'+(index+1)*0.02+'s'+';'}}" wx:for="{{list}}" wx:key="index">
            <view class="user-img">
                <image class="img" mode="aspectFill" src="{{item.avatarurl}}"></image>
            </view>
            <view class="right">
                <view class="head-box">
                    <view class="name">{{item.nickname}}</view>
                </view>
                <view class="describe">
                    <text class="txt">{{item.title}}</text>
                </view>
                <view class="img-box">
                    <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'e0',['$event'] ] ] ] ]}}" data-event-params="{{({item:item,index2:index2})}}" wx:for="{{item.imgs}}" wx:for-index="index2" wx:for-item="item2" wx:key="index2">
                        <image class="img" mode="aspectFill" src="{{item2}}"></image>
                    </view>
                </view>
                <view class="bot">
                    <view class="time">{{item.create_time}}</view>
                </view>
            </view>
        </view>
    </view>
    <wk-tabar bind:__l="__l" vueId="5bef7571-1"></wk-tabar>
    <wk-login-modal bind:__l="__l" vueId="5bef7571-2"></wk-login-modal>
    <wk-skeletons bind:__l="__l" type="detail" vueId="5bef7571-3" wx:if="{{isLoading}}"></wk-skeletons>
</view>
