.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #efc480, #f8dca5 25%, #fff 98%);
}
.container .head-box .cuIcon-back {
  font-size: 50rpx !important;
  font-weight: 500;
}
.container .logo {
  width: 410rpx;
  height: 120rpx;
}
.container .logo-bg {
  width: 640rpx;
  height: 300rpx;
}
.wrapper {
  position: absolute;
  z-index: 90;
  padding-bottom: 40rpx;
  padding-top: 115px;
  width: 100vw;
  height: 100vh;
  top: 0;
}
.wrapper .login-box {
  margin-top: 140rpx;
}
.wrapper .login-box .input-item {
  height: 108rpx;
  border-bottom: 1rpx solid rgba(208, 177, 123, 0.3);
  width: 608rpx;
}
.wrapper .login-box .input-item .inp-title {
  font-size: 30rpx;
  color: #845708;
  padding-right: 30rpx;
}
.wrapper .login-box .input-item .inp {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}
.wrapper .login-box .input-item .pl {
  color: #c8963d;
}
.wrapper .login-box .input-item .code-btn {
  background: none;
  font-size: 28rpx;
  color: #845708;
  border-left: 1rpx solid #d0b17b;
  border-radius: 0;
  height: 42rpx;
  width: 190rpx;
  padding: 0;
}
.wrapper .login-btn {
  width: 630rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-top: 70rpx;
  background: linear-gradient(90deg, #e9b461, #eecc89);
  box-shadow: 0 7rpx 6rpx 0 rgba(229, 138, 0, 0.22);
  color: #fff;
}
.wrapper .tip-box {
  width: 630rpx;
  line-height: 108rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #c8963d;
}
.wrapper .tip-box .tcp-radio {
  transform: scale(0.5);
}
.wrapper .tip-box .tcp {
  text-decoration: underline;
}
