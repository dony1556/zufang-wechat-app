.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #fff;
}
.container .head-box .cuIcon-back {
  font-size: 50rpx !important;
  font-weight: 500;
}
.container .logo {
  width: 410rpx;
  height: 120rpx;
}
.container .logo-bg {
  width: 640rpx;
  height: 300rpx;
}
.wrapper {
  position: absolute;
  z-index: 90;
  padding-bottom: 40rpx;
  padding-top: 115px;
  width: 100vw;
  height: 100vh;
  top: 0;
}
.wrapper .tab-box {
  margin: 60rpx auto 30rpx;
  width: 608rpx;
}
.wrapper .tab-box .tab-item {
  flex: 1;
  height: 80rpx;
  position: relative;
}
.wrapper .tab-box .tab-item .tab-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #845708;
}
.wrapper .tab-box .tab-item .line-box {
  position: absolute;
  width: 300rpx;
  height: 4rpx;
  background: #e9b562;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.wrapper .tab-box .tab-item .line-box .triangle {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  disply: block;
  width: 0;
  height: 0;
  border-width: 10rpx;
  border-style: solid;
  border-color: transparent transparent #e9b562 transparent;
}
.wrapper .login-box .input-item {
  height: 108rpx;
  border-bottom: 1rpx solid rgba(208, 177, 123, 0.3);
  width: 608rpx;
}
.wrapper .login-box .input-item .inp {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
}
.wrapper .login-box .input-item .pl {
  color: #c8963d;
}
.wrapper .login-box .input-item .code-btn {
  background: none;
  font-size: 28rpx;
  color: #845708;
}
.wrapper .login-btn {
  width: 630rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-top: 70rpx;
  background-color: #3dbcc6;
  box-shadow: 0 7rpx 6rpx 0 rgba(229, 138, 0, 0.22);
  color: #fff;
}
.wrapper .tip-box {
  width: 630rpx;
}
.wrapper .tip-box .tip-btn {
  font-size: 26rpx;
  font-family: PingFang SC;
  font-weight: 400;
  text-decoration: underline;
  color: #c8963d;
  background: none;
}
.wrapper .wx-logo-box {
  font-size: 26rpx;
  font-family: PingFang SC;
  font-weight: 400;
  color: #c8963d;
  margin-top: 80rpx;
  background: none;
  display: block;
}
.wrapper .wx-logo-box:hover {
  background: none;
}
.wrapper .wx-logo-box .auto-login {
  width: 80rpx;
  height: 80rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}
