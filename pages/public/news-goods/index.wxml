<view class="page">
    <view class="float-box">
        <view bindtap="__e" class="my" data-event-opts="{{[ [ 'tap',[ [ 'navtoMy',['$event'] ] ] ] ]}}">我的</view>
        <view bindtap="__e" class="pub" data-event-opts="{{[ [ 'tap',[ [ 'pub',['$event'] ] ] ] ]}}">+</view>
    </view>
    <view class="item-box">
        <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'detail',['$0'],[ [ ['list','',index,'id'] ] ] ] ] ] ]}}" wx:for="{{$root.l0}}" wx:key="index">
            <view class="user_img">
                <image src="{{item.$orig.avatarurl}}"></image>
            </view>
            <view class="right">
                <view class="head-box">
                    <view class="name">{{item.$orig.nickname}}</view>
                </view>
                <view class="describe">
                    <text class="txt">{{item.$orig.title}}</text>
                </view>
                <view class="img-box">
                    <view class="item" wx:for="{{item.$orig.imgs}}" wx:for-index="index2" wx:for-item="item2" wx:key="index2">
                        <image class="img" mode="widthFix" src="{{item2}}"></image>
                    </view>
                </view>
                <view class="bot">
                    <view class="time">{{item.$orig.create_time}}</view>
                </view>
                <view class="p" wx:if="{{item.g0}}">
                    <view class="zans">
                        <text class="iconfont icon-xin" style="font-size:32rpx;color:#0643b4;margin-right:8rpx;"></text>
                    </view>
                    <view class="pls">
                        <view wx:for="{{item.$orig.pls}}" wx:for-index="index3" wx:for-item="item3" wx:key="index3">
                            <text class="name">{{item3.name+'：'}}</text>
                            <text class="comment">{{item3.comment}}</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>
    <wk-login-modal bind:__l="__l" vueId="bbd14cac-1"></wk-login-modal>
    <wk-skeletons bind:__l="__l" type="detail" vueId="bbd14cac-2" wx:if="{{isLoading}}"></wk-skeletons>
</view>
