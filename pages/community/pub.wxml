<view class="page">
    <view class="top-box"></view>
    <scroll-view class="scroll-box">
        <view bindsubmit="__e" class="form" data-event-opts="{{[ [ 'submit',[ [ 'formSubmit',['$event'] ] ] ] ]}}">
            <view class="form-item">
                <text class="title">小区名称</text>
                <view class="right">
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','name','$event',[] ],['community'] ] ] ] ]}}" placeholder="请输入小区完整名称" value="{{community.name}}"></input>
                </view>
            </view>
            <view class="form-item">
                <text class="title">小区相册</text>
                <view class="right">
                    <view class="img-box">
                        <view class="preview-box" wx:for="{{community.detail_imgs}}" wx:key="index">
                            <image class="preview-img" mode="aspectFill" src="{{item}}"></image>
                            <text bindtap="__e" class="cuIcon-close" data-event-opts="{{[ [ 'tap',[ [ 'delImg',['$0',index],['community.detail_imgs'] ] ] ] ]}}"></text>
                        </view>
                        <view bindtap="__e" class="choose-img x-c " data-event-opts="{{[ [ 'tap',[ [ 'onChooseImg',['$0',9],['community.detail_imgs'] ] ] ] ]}}" wx:if="{{$root.g0<9}}">
                            <text class="cuIcon-cameraadd"></text>
                        </view>
                    </view>
                </view>
            </view>
            <view bindtap="__e" class="form-item" data-event-opts="{{[ [ 'tap',[ [ 'openCityArea',['$event'] ] ] ] ]}}">
                <text class="title">区域</text>
                <view class="right">
                    <view class="choose-box">
                        <view class="text">{{community.cab_names||'请选择'}}</view>
                        <view class="iconfont icon-you icon" style="font-size:22rpx;color:#b8b8b8;"></view>
                    </view>
                </view>
            </view>
            <view class="form-item">
                <view class="title">位置</view>
                <view bindtap="__e" class="right" data-event-opts="{{[ [ 'tap',[ [ 'openMap',['$event'] ] ] ] ]}}">
                    <view class="choose-box">
                        <view class="text">{{community.lng>0?'编辑':'请选择'}}</view>
                        <view class="iconfont icon-you icon" style="font-size:22rpx;color:#b8b8b8;"></view>
                    </view>
                </view>
            </view>
            <view class="form-item">
                <text class="title">地址</text>
                <view class="right">
                    <input bindinput="__e" class="input" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '$0','address','$event',[] ],['community'] ] ] ] ]}}" placeholder="请输入地址" value="{{community.address}}"></input>
                </view>
            </view>
            <view class="btn-box"></view>
        </view>
    </scroll-view>
    <view class="footer-box">
        <form bindsubmit="__e" class="form" data-event-opts="{{[ [ 'submit',[ [ 'formSubmit',['$event'] ] ] ] ]}}">
            <button class="submit" formType="submit" type="primary">提交</button>
        </form>
    </view>
    <wk-city-area bind:__l="__l" bind:onConfirm="__e" class="vue-ref" data-event-opts="{{[ [ '^onConfirm',[ ['cityAreaConfirm'] ] ] ]}}" data-ref="cityArea" vueId="6b89cbd0-1"></wk-city-area>
</view>
