.page {
  background-color: #fff;
  width: 100%;
  height: 100vh;
  flex-direction: column;
}
.page .content-box {
  flex: 1;
  overflow-y: auto;
}
.page .content-box .top-box {
  display: flex;
  height: 100rpx;
}
.page .content-box .top-box .item {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .content-box .top-box .item.active {
  font-weight: 700;
  color: #000;
  font-size: 32rpx;
}
.page .swiper-box {
  width: 100%;
  height: 450rpx;
  position: relative;
}
.page .swiper-box .carousel {
  width: 100%;
  height: 450rpx;
}
.page .swiper-box .carousel .carousel-item {
  width: 100%;
  height: 450rpx;
}
.page .swiper-box .carousel .carousel-item .img {
  width: 100%;
  height: 100%;
}
.page .swiper-box .label-box {
  position: absolute;
  bottom: 18rpx;
  left: 18rpx;
  width: 90%;
  display: flex;
}
.page .swiper-box .label-box .label {
  margin-right: 13rpx;
  padding: 0 14rpx;
  line-height: 32rpx;
  color: #fff;
  font-size: 20rpx;
}
.page .swiper-box .label-box .label.active {
  background: #fff;
  color: #333;
  border: #fff;
  border-radius: 100rpx;
}
.page .swiper-box .num-box {
  position: absolute;
  right: 30rpx;
  bottom: 20rpx;
  color: #fff;
  font-size: 20rpx;
  width: 43rpx;
  height: 28rpx;
}
.page .box-1 {
  padding: 20rpx 30rpx;
  border-bottom: 10rpx solid #f7f8f9;
  position: relative;
}
.page .box-1 .title-box .img {
  width: 32rpx;
  height: 32rpx;
}
.page .box-1 .title-box .title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0e1010;
}
.page .box-1 .title-box .keywords {
  font-size: 26rpx;
  margin-top: 16rpx;
}
.page .box-1 .address {
  display: flex;
  padding: 12rpx 0rpx;
  color: #007aff;
}
.page .box-1 .address .title {
  font-size: 24rpx;
}
.page .box-1 .address .name {
  flex: 1;
}
.page .box-1 .address .icon {
  font-size: 30rpx;
}
.page .map-box .community-box {
  display: flex;
  align-items: center;
  height: 100rpx;
  background-color: #fff;
  padding: 20rpx 30rpx;
  margin-top: 10rpx;
}
.page .map-box .community-box .name {
  font-size: 34rpx;
  font-weight: 700;
  flex: 1;
}
.page .map-box .community-box .detail {
  color: #007aff;
  margin-right: 8rpx;
}
.page .map-box .community-box .icon {
  font-size: 30rpx;
  color: #999;
}
.page .detail-box {
  padding: 20rpx 20rpx;
  background-color: #fff;
}
.page .detail-box .head {
  font-size: 32rpx;
  font-weight: 700;
}
.page .detail-box .content {
  padding: 20rpx 10rpx;
  font-size: 26rpx;
}
.page .select-box {
  display: flex;
  height: 100rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #efefef;
}
.page .select-box .item {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .select-box .item.active {
  font-weight: 700;
  color: #000;
  font-size: 32rpx;
}
.page .house-box {
  display: flex;
  flex-direction: column;
  background-color: #fff;
}
.page .house-box .title-box {
  width: 100%;
  padding: 20rpx 30rpx;
}
.page .house-box .title-box .title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.page .house-box .content {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 20rpx 0rpx;
  border-radius: 10rpx;
}
.page .footer-box {
  width: 100%;
}
