.page {
  width: 100%;
}
.page .tip {
  height: 100rpx;
  display: flex;
  align-items: center;
  background-color: #fef9e6;
  color: #f9922b;
  padding: 0rpx 20rpx;
  font-size: 26rpx;
}
.page .scroll-box {
  width: 100%;
  height: calc(100vh - 110rpx);
  overflow-y: auto;
}
.page .form {
  width: 718rpx;
  margin: 10rpx 16rpx;
  background-color: #fff;
}
.page .form .form-item {
  width: 100%;
  padding: 10rpx 20rpx;
  display: flex;
  border-bottom: 1rpx solid hsla(0, 0%, 90.6%, 0.5);
}
.page .form .form-item .title {
  width: 180rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 26rpx;
}
.page .form .form-item .right {
  flex: 1;
  display: flex;
  align-items: center;
}
.page .form .form-item .right .choose-box {
  width: 100%;
  display: flex;
  flex: 1;
  align-items: center;
  height: 90rpx;
}
.page .form .form-item .right .choose-box .text {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 26rpx;
  width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.page .form .form-item .right .choose-box .icon {
  font-size: 32rpx;
  color: #c4c4c4;
  margin-right: 10rpx;
}
.page .form .form-item .right .img-box {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
}
.page .form .form-item .right .img-box .choose-img,
.page .form .form-item .right .img-box .preview-box {
  width: 90rpx;
  height: 90rpx;
  background: #f9fafb;
  border: 1rpx solid #efefef;
  margin-right: 25rpx;
  margin-bottom: 25rpx;
  position: relative;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.page .form .form-item .right .img-box .choose-img:nth-child(5n),
.page .form .form-item .right .img-box .preview-box:nth-child(5n) {
  margin-right: 0;
}
.page .form .form-item .right .img-box .choose-img .cuIcon-cameraadd,
.page .form .form-item .right .img-box .preview-box .cuIcon-cameraadd {
  font-size: 42rpx;
  color: #e9e9e9;
}
.page .form .form-item .right .img-box .choose-img .preview-img,
.page .form .form-item .right .img-box .preview-box .preview-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.page .form .form-item .right .img-box .choose-img .cuIcon-close,
.page .form .form-item .right .img-box .preview-box .cuIcon-close {
  background: linear-gradient(90deg, #f50, #ffd387);
  border-radius: 50%;
  width: 36rpx;
  line-height: 36rpx;
  color: #fff;
  text-align: center;
  position: absolute;
  top: -10rpx;
  right: -10rpx;
}
.page .form .form-item .right .picker {
  width: 100%;
}
.page .form .form-item .right .picker .picker-box {
  height: 90rpx;
  width: 100%;
  display: flex;
  align-items: center;
}
.page .form .form-item .right .picker .picker-box .text {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 26rpx;
}
.page .form .form-item .right .input {
  flex: 1;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 26rpx;
}
.page .form .form-item .right .unit {
  padding: 0 20rpx;
  height: 90rpx;
  line-height: 90rpx;
  font-size: 22rpx;
  color: #a0a0a0;
}
.page .form .form-item .right .but {
  padding: 0 30rpx;
  height: 60rpx;
  font-size: 24rpx;
  color: #fff;
  background-color: #f50;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
}
.page .form .form-item .right .but .txt {
  margin-left: 6rpx;
}
.page .form .form-item2 {
  width: 100%;
  padding: 10rpx 30rpx;
  display: flex;
  flex-direction: column;
  border-bottom: 1rpx solid hsla(0, 0%, 87.5%, 0.5);
}
.page .form .form-item2 .title-box {
  display: flex;
  align-items: center;
  height: 90rpx;
}
.page .form .form-item2 .title-box .title {
  height: 70rpx;
  line-height: 70rpx;
  font-size: 26rpx;
}
.page .form .form-item2 .title-box .mark {
  font-size: 22rpx;
}
.page .form .form-item2 .input {
  height: 90rpx;
  line-height: 90rpx;
  font-size: 26rpx;
}
.page .form .form-item2 .bot-box .textarea {
  width: 100%;
  border-radius: 12rpx;
  height: 250rpx;
  border: 1rpx solid #eee;
  padding: 16rpx;
  font-size: 26rpx;
}
.page .footer-box {
  height: 110rpx;
}
.page .footer-box .submit {
  position: fixed;
  bottom: 26rpx;
  left: 50rpx;
  width: 650rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 40rpx;
  background: linear-gradient(45deg, #f50, #ffb8ae);
  font-size: 26rpx;
}
