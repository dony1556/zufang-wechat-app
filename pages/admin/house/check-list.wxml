<view class="page">
    <view class="house-box">
        <view bindtap="__e" class="item" data-event-opts="{{[ [ 'tap',[ [ 'select_item',[index] ] ] ] ]}}" wx:for="{{houseList}}" wx:key="index">
            <view class="top">
                <view class="title">{{item.title}}</view>
                <view class="iconfont icon-you" style="font-size:20rpx;color:#999;"></view>
            </view>
            <view class="bot">
                <view class="tip">
                    <block wx:if="{{item.check_status==0}}">
                        <icon color="#00aa00" size="12" style="margin-right:12rpx;" type="waiting"></icon>等待审核</block>
                </view>
                <view class="button-box" wx:if="{{select_index==index}}">
                    <view catchtap="__e" class="bt" data-event-opts="{{[ [ 'tap',[ [ 'agreeHandle',['$0'],[ [ ['houseList','',index] ] ] ] ] ] ]}}" style="background-color:#2DE8BD;">通过</view>
                    <view catchtap="__e" class="bt" data-event-opts="{{[ [ 'tap',[ [ 'refuseHandle',['$0'],[ [ ['houseList','',index] ] ] ] ] ] ]}}" style="background-color:#FF9700;">拒绝</view>
                    <view catchtap="__e" class="bt" data-event-opts="{{[ [ 'tap',[ [ 'navtoDetail',['$0'],[ [ ['houseList','',index] ] ] ] ] ] ]}}" style="background-color:#55aa00;">预览</view>
                </view>
            </view>
        </view>
    </view>
    <wk-empty bind:__l="__l" emptyData="{{emptyData}}" vueId="1f35dc5b-1" wx:if="{{$root.g0==0}}"></wk-empty>
    <view class="comment2-box">
        <view bindtap="__e" class="{{['comment-shadow',commentModal>0?'on':'']}}" data-event-opts="{{[ [ 'tap',[ [ 'commentClose',['$event'] ] ] ] ]}}"></view>
        <view catchtap="__e" class="{{['comment-box',commentModal>0?'on':'']}}" data-event-opts="{{[ [ 'tap',[ [ '',['$event'] ] ] ] ]}}">
            <view class="comment-content">
                <textarea bindinput="__e" class="comment" data-event-opts="{{[ [ 'input',[ [ '__set_model',[ '','comment_msg','$event',[] ] ] ] ] ]}}" placeholder="请填写拒绝原因" value="{{comment_msg}}"></textarea>
                <button bindtap="__e" class="btn" data-event-opts="{{[ [ 'tap',[ [ 'confirmRefuse',['$event'] ] ] ] ]}}">确认</button>
            </view>
        </view>
    </view>
</view>
