.page .scroll-box {
  width: 100%;
  border-bottom: 1rpx solid #f7f8f9;
  position: -webkit-sticky;
  position: sticky;
  top: 0rpx;
  background-color: #fff;
}
.page .scroll-box .scroll {
  height: 90rpx;
  white-space: nowrap;
  width: 100%;
  text-align: center;
}
.page .scroll-box .scroll .item {
  height: 100rpx;
  padding: 0 30rpx;
  display: inline-block;
}
.page .scroll-box .scroll .item .name {
  height: 70rpx;
  line-height: 70rpx;
}
.page .scroll-box .scroll .item .line {
  margin-left: 30%;
  width: 40%;
  height: 6rpx;
  background-color: #f50;
  border-radius: 6rpx;
}
.page .house-box .item {
  display: flex;
  flex-direction: column;
  padding: 16rpx 12rpx;
  margin: 20rpx 20rpx;
  border-radius: 8rpx;
  background-color: #fff;
}
.page .house-box .item .top {
  display: flex;
  align-items: center;
  height: 66rpx;
}
.page .house-box .item .top .title {
  flex: 1;
  width: 0rpx;
  font-size: 26rpx;
}
.page .house-box .item .top .status {
  margin: 0rpx 12rpx;
  color: red;
  font-size: 24rpx;
}
.page .house-box .item .bot {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}
.page .house-box .item .bot .tip {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: #c5c5c5;
}
.page .house-box .item .bot .top-msg {
  font-size: 26rpx;
  color: #e7b72f;
  margin-top: 20rpx;
}
.page .house-box .item .bot .button-box {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  background-color: #f8f8f8;
  padding: 20rpx 20rpx;
}
.page .house-box .item .bot .button-box .bt {
  width: 40%;
  margin: 20rpx 5%;
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 35rpx;
  text-align: center;
  color: #fff;
}
.page .comment2-box .comment-shadow {
  position: fixed;
  left: 0;
  width: 100%;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 9999;
  transition: all 0.3s ease-in-out;
  opacity: 0;
  visibility: hidden;
}
.page .comment2-box .comment-shadow.on {
  opacity: 1;
  visibility: visible;
}
.page .comment2-box .comment-box {
  position: fixed;
  top: 30vh;
  left: 50rpx;
  right: 50rpx;
  transform: translate3d(0, 100vh, 0);
  transform-origin: center;
  transition: all 0.3s ease-in-out;
  z-index: 99999;
  visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
}
.page .comment2-box .comment-box.on {
  transform: translateZ(0);
  visibility: visible;
}
.page .comment2-box .comment-box .comment-content {
  width: 100%;
  padding: 30rpx 40rpx;
  border-radius: 16rpx;
  position: relative;
}
.page .comment2-box .comment-box .comment-content .comment {
  height: 300rpx;
  font-size: 24rpx;
  width: 100%;
  padding: 16rpx 16rpx;
  border: 1rpx solid #fafafa;
}
.page .comment2-box .comment-box .comment-content .btn {
  width: 500rpx;
  height: 78rpx;
  line-height: 78rpx;
  background-color: #f50;
  color: #fff;
  margin-top: 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
