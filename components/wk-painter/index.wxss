.back-shadow {
  position: fixed;
  left: 0;
  width: 100%;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 9999;
  transition: all 0.6s ease-in-out;
  opacity: 0;
  visibility: hidden;
}
.back-shadow.on {
  opacity: 1;
  visibility: visible;
}
.box {
  position: fixed;
  width: 100%;
  bottom: 0rpx;
  left: 0rpx;
  width: 750rpx;
  height: 100vh;
  transform: translate3d(0, 100vh, 0);
  transform-origin: center;
  transition: all 0.6s ease-in-out;
  z-index: 9999999;
  visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.box.on {
  transform: translateZ(0);
  visibility: visible;
}
.box .head {
  height: 100rpx;
  width: 750rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  border-bottom: 1rpx solid #eee;
}
.box .content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.box .content .bg {
  width: 70vw;
  height: 80vh;
  z-index: 99999;
  background: linear-gradient(45deg, #ff971b, #ff5000);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}
.box .content .img {
  width: 80vw;
  height: 80vh;
  z-index: 99999;
}
.box .content .btn1 {
  width: 500rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #eb3919;
  color: #fff;
  margin-top: 50rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
