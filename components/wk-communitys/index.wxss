@charset "UTF-8";
.c-box {
  background-color: #f6f7fb;
  padding-top: 20rpx;
}
.c-box .house {
  display: flex;
  background-color: #fff;
  padding: 30rpx 16rpx;
  margin: 0rpx 20rpx 20rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 8rpx #efefef;
}
.c-box .house .img-box {
  width: 250rpx;
  height: 180rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}
.c-box .house .img-box .img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.c-box .house .img-box .icon-box {
  position: absolute;
  left: 20rpx;
  bottom: 12rpx;
  display: flex;
  justify-content: center;
}
.c-box .house .img-box .icon-box .item {
  margin-right: 20rpx;
  font-size: 36rpx;
  color: #fff;
}
.c-box .house .house-right {
  flex: 1;
  width: 0;
}
.c-box .house .house-right .title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 35rpx;
  height: 35rpx;
  color: #000;
  font-size: 30rpx;
  font-weight: 700;
}
.c-box .house .house-right .sx {
  display: flex;
  justify-content: start;
  align-items: center;
  min-height: 35rpx;
  margin-top: 12rpx;
}
.c-box .house .house-right .sx .label {
  margin: 8rpx;
  color: #999;
  font-size: 24rpx;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}
.c-box .house .house-right .bq {
  min-height: 35rpx;
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 26rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}
.c-box .house .house-right .bq .label {
  margin-right: 15rpx;
  color: #999;
  font-size: 24rpx;
  line-height: 34rpx;
  border-radius: 10rpx;
  border: 1rpx solid #eee;
  padding: 0 8rpx;
  flex-shrink: 0;
}
.c-box .house .house-right .sale_price {
  font-size: 30rpx;
  color: #ff0036;
  font-weight: 700;
  margin-left: 30rpx;
}
.c-box .house .house-right .sale_price::after {
  content: " 万元";
  color: red;
  font-size: 20rpx;
}
.c-box .house .house-right .money-box {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}
.c-box .house .house-right .money-box .money {
  font-size: 32rpx;
  color: #ff0036;
  font-weight: 700;
  margin-right: 20rpx;
}
.c-box .house .house-right .money-box .money::after {
  content: " 元/㎡";
  color: red;
  font-size: 20rpx;
}
.c-box .house .house-right .address {
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #999;
  margin-top: 10rpx;
}
