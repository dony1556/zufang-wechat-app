.back-shadow {
  position: fixed;
  left: 0;
  width: 100%;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 9999;
  transition: all 0.6s ease-in-out;
  opacity: 0;
  visibility: hidden;
}
.back-shadow.on {
  opacity: 1;
  visibility: visible;
}
.box {
  position: fixed;
  width: 100%;
  bottom: 0rpx;
  left: 0rpx;
  width: 750rpx;
  height: 100vh;
  transform: translate3d(0, -100vh, 0);
  transform-origin: center;
  transition: all 0.6s ease-in-out;
  z-index: 9999;
  visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.box.on {
  transform: translateZ(0);
  visibility: visible;
}
.box .head {
  height: 100rpx;
  width: 750rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  border-bottom: 1rpx solid #eee;
}
.box .content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.box .content .img-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  width: 600rpx;
  border-radius: 12rpx;
  padding: 20rpx 0rpx;
  z-index: 9999999;
}
.box .content .img-box .img {
  width: 500rpx;
  height: 500rpx;
  z-index: 9999999;
}
.box .content .img-box .tip {
  font-size: 30rpx;
  margin-top: 20rpx;
}
.box .content .img-box .tip2 {
  font-size: 24rpx;
  color: #dbdbdb;
  margin-top: 16rpx;
}
.box .content .del {
  margin-top: 50rpx;
  font-size: 42rpx;
  color: #fff;
}
