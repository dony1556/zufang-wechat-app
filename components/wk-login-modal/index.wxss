.agreement-box {
  display: flex;
  align-items: center;
  padding-top: 30rpx;
}
.checkbox-wrapper {
  display: flex;
  align-items: center;
  cursor: pointer;
}
.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}
.checkbox.checked {
  background-color: #3dbcc6;
  border-color: #3dbcc6;
}
.check-icon {
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}
.agreement-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  margin-left: 10rpx;
  line-height: 1.5;
}
.link-text {
  color: #3dbcc6;
  text-decoration: none;
}
