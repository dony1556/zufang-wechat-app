.login-shadow {
  position: fixed;
  left: 0;
  width: 100%;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 9999;
  transition: all 0.3s ease-in-out;
  opacity: 0;
  visibility: hidden;
}
.login-shadow.on {
  opacity: 1;
  visibility: visible;
}
.l-box {
  position: fixed;
  width: 100%;
  bottom: 0rpx;
  left: 0rpx;
  width: 750rpx;
  transform: translate3d(0, 100vh, 0);
  transform-origin: center;
  transition: all 0.6s ease-in-out;
  z-index: 99999;
  visibility: hidden;
  display: flex;
  flex-direction: column;
  background-color: #fff;
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
}
.l-box.on {
  transform: translateZ(0);
  visibility: visible;
}
.l-box .login-head {
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  font-size: 32rpx;
  font-weight: 500;
}
.close-icon {
  position: absolute;
  right: 30rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.close-icon::before,
.close-icon::after {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 3rpx;
  background-color: #999;
  border-radius: 2rpx;
}
.close-icon::before {
  transform: rotate(45deg);
}
.close-icon::after {
  transform: rotate(-45deg);
}
.close-icon:active {
  transform: scale(0.9);
  opacity: 0.7;
}



.l-box .login-content {
  width: 100%;
  height: 500rpx;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  position: relative;
}
.l-box .login-content .tip {
  padding: 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c6d9db;
}
