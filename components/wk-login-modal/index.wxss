.login-shadow {
  position: fixed;
  left: 0;
  width: 100%;
  top: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  z-index: 9999;
  transition: all 0.3s ease-in-out;
  opacity: 0;
  visibility: hidden;
}
.login-shadow.on {
  opacity: 1;
  visibility: visible;
}
.l-box {
  position: fixed;
  width: 100%;
  bottom: 0rpx;
  left: 0rpx;
  width: 750rpx;
  transform: translate3d(0, 100vh, 0);
  transform-origin: center;
  transition: all 0.6s ease-in-out;
  z-index: 99999;
  visibility: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
}
.l-box.on {
  transform: translateZ(0);
  visibility: visible;
}
.l-box .login-head {
  height: 90rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.l-box .login-content {
  width: 100%;
  height: 500rpx;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  position: relative;
}
.l-box .login-content .tip {
  padding: 40rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c6d9db;
}
.l-box .login-content .btn {
  width: 500rpx;
  height: 76rpx;
  line-height: 76rpx;
  background-color: #f50;
  color: #fff;
  margin-top: 40rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
}
