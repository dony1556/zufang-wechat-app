.h-box {
  background-color: #f6f7fb;
  padding: 20rpx 0rpx 1rpx 0rpx;
}
.h-box .hover-house {
  box-shadow: none !important;
  opacity: 0.9 !important;
}
.h-box .house {
  display: flex;
  background-color: #fff;
  padding: 30rpx 16rpx;
  margin: 0rpx 20rpx 20rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 4rpx 8rpx 8rpx #ebebeb;
}
.h-box .house .img-box {
  width: 250rpx;
  height: 180rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  position: relative;
}
.h-box .house .img-box .img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}
.h-box .house .img-box .icon-box {
  position: absolute;
  left: 20rpx;
  bottom: 12rpx;
  display: flex;
  justify-content: center;
}
.h-box .house .img-box .icon-box .item {
  margin-right: 20rpx;
  font-size: 36rpx;
  color: #fff;
}
.h-box .house .house-right {
  flex: 1;
  width: 0;
}
.h-box .house .house-right .title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #333;
  font-size: 36rpx;
}
.h-box .house .house-right .sx {
  display: flex;
  justify-content: start;
  align-items: center;
  margin-top: 12rpx;
}
.h-box .house .house-right .sx .la {
  margin: 8rpx 16rpx 8rpx 0;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 4rpx;
}
.h-box .house .house-right .sx .label {
  margin: 8rpx 16rpx 8rpx 0;
  color: #999;
  font-size: 28rpx;
  border-radius: 4rpx;
}
.h-box .house .house-right .bq {
  white-space: nowrap;
  margin-top: 8rpx;
}
.h-box .house .house-right .bq .la {
  margin: 8rpx 16rpx 8rpx 0;
  font-size: 28rpx;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  display: inline-block;
}
.h-box .house .house-right .money-box {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}
.h-box .house .house-right .money-box .money {
  font-size: 30rpx;
  color: #ff0036;
  font-weight: 700;
}
.h-box .house .house-right .money-box .unit {
  color: #ff0036;
  font-size: 24rpx;
  margin-left: 4rpx;
}
.h-box .house .house-right .money-box .address {
  flex: 1;
  width: 0;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #999;
  margin-left: 30rpx;
}
